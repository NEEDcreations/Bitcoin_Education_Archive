.env.*
!functions/.env.bitcoin-quest-staging
functions/private-bank/*
!functions/private-bank/README.md
# Trivia answer key for functions/scripts/upload-trivia-key.js. Never commit.
functions/private-bank/trivia-key.json
test.sh
scripts/*
!scripts/update-ticker.js
!scripts/update-ticker.sh
!scripts/migrate-push-optin.js
!scripts/backfill-badge-favor.js
!scripts/raid-boss-activity.js
!scripts/raid-boss-inspect.js
!scripts/backfill-leaderboard-snapshots.js
!scripts/backfill-join-dates.js
!scripts/render-miniapp-og.py
!scripts/staging/
scripts/staging/*
!scripts/staging/seed-favor-winners.js
.keys/
firebase-debug.log
firestore-debug.log
images/
.firebase/
username-spaces-private/
.wrangler/
**/.wrangler/
*.bak
*.bak*
*.working-backup
*.src.bak

# Staging build output (scripts/build-staging.sh). Holds staging-only material
