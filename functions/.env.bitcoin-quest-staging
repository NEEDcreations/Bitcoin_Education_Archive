# Staging Firestore (default) is us-east1. The default <project>-backups
# bucket is in us-central1 and cannot receive managed exports.
# Firebase loads this file only when deploying to bitcoin-quest-staging.
# Do not add functions/.env or functions/.env.bitcoin-education-archive.
BQ_BACKUP_BUCKET=bitcoin-quest-staging-backups-use1
# Premium: no BTCPay store on staging yet (Phil, Nov 14). Card checkout only;
# BTCPay secrets stay unbound and lightningEnabled stays off.
PREMIUM_BTCPAY=off
