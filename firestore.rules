rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin helper — uses custom claim, never hardcoded emails ────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Client-created notification ids. Server Admin SDK writes are not checked here.
    function notifIdOk(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function lnShape(v) {
      return v is string && v.size() >= 5 && v.size() <= 320
        && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // The first Lightning address saved on a profile stays. Once any address
    // value exists, the client cannot write the address fields or the marker.
    // The server still writes the normalized lock and the one-time reset doc.
    function lightningLockOk() {
      let oldL = 'lightning' in resource.data && resource.data.lightning is string ? resource.data.lightning : '';
      let oldA = 'lightningAddress' in resource.data && resource.data.lightningAddress is string ? resource.data.lightningAddress : '';
      let oldN = 'lnAddress' in resource.data && resource.data.lnAddress is string ? resource.data.lnAddress : '';
      let newL = 'lightning' in request.resource.data && request.resource.data.lightning is string ? request.resource.data.lightning : '';
      let newA = 'lightningAddress' in request.resource.data && request.resource.data.lightningAddress is string ? request.resource.data.lightningAddress : '';
      let newN = 'lnAddress' in request.resource.data && request.resource.data.lnAddress is string ? request.resource.data.lnAddress : '';
      let fresh = newL.size() > 0 ? newL : (newA.size() > 0 ? newA : newN);
      let hasAny = oldL.size() > 0 || oldA.size() > 0 || oldN.size() > 0;
      let touched = request.resource.data.diff(resource.data).affectedKeys().hasAny(['lightning', 'lightningAddress', 'lnAddress', 'ln_reset_used']);
      let firstSet = !hasAny
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ln_reset_used'])
        && (fresh.size() == 0 || lnShape(fresh))
        && (newL.size() == 0 || newL == fresh)
        && (newA.size() == 0 || newA == fresh)
        && (newN.size() == 0 || newN == fresh);
      return (!touched) || (!hasAny && firstSet);
    }

    // notificationPrefs: owner booleans only, fixed keys. Missing keys use server defaults.
    function notificationPrefsOk() {
      return !('notificationPrefs' in request.resource.data) || (
        request.resource.data.notificationPrefs is map
        && request.resource.data.notificationPrefs.keys().hasOnly([
          'master', 'rewards', 'gifts', 'favor', 'pvp', 'predictions',
          'mentions', 'dms', 'plebtalk', 'reminders', 'news', 'referrals'
        ])
        && (!('master' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.master is bool)
        && (!('rewards' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.rewards is bool)
        && (!('gifts' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.gifts is bool)
        && (!('favor' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.favor is bool)
        && (!('pvp' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.pvp is bool)
        && (!('predictions' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.predictions is bool)
        && (!('mentions' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.mentions is bool)
        && (!('dms' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.dms is bool)
        && (!('plebtalk' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.plebtalk is bool)
        && (!('reminders' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.reminders is bool)
        && (!('news' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.news is bool)
        && (!('referrals' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.referrals is bool)
      );
    }

    // Prompt state can only move forward. stopped and dontAsk latch on.
    function notifPromptOk() {
      return !('notifPrompt' in request.resource.data) || (
        request.resource.data.notifPrompt is map
        && request.resource.data.notifPrompt.keys().hasOnly(['count', 'lastAsked', 'stopped', 'dontAsk'])
        && (!('count' in request.resource.data.notifPrompt) || (
          request.resource.data.notifPrompt.count is int
          && request.resource.data.notifPrompt.count >= 0
          && request.resource.data.notifPrompt.count <= 3
        ))
        && (!('lastAsked' in request.resource.data.notifPrompt) || (
          request.resource.data.notifPrompt.lastAsked is int
          && request.resource.data.notifPrompt.lastAsked >= 0
        ))
        && (!('stopped' in request.resource.data.notifPrompt) || request.resource.data.notifPrompt.stopped is bool)
        && (!('dontAsk' in request.resource.data.notifPrompt) || request.resource.data.notifPrompt.dontAsk is bool)
        && (
          !('notifPrompt' in resource.data)
          || !(resource.data.notifPrompt is map)
          || (
            (!('count' in request.resource.data.notifPrompt) || !('count' in resource.data.notifPrompt) || !(resource.data.notifPrompt.count is int) || request.resource.data.notifPrompt.count >= resource.data.notifPrompt.count)
            && (!('lastAsked' in request.resource.data.notifPrompt) || !('lastAsked' in resource.data.notifPrompt) || !(resource.data.notifPrompt.lastAsked is int) || request.resource.data.notifPrompt.lastAsked >= resource.data.notifPrompt.lastAsked)
            && (!(resource.data.notifPrompt.stopped == true) || request.resource.data.notifPrompt.stopped == true)
            && (!(resource.data.notifPrompt.dontAsk == true) || request.resource.data.notifPrompt.dontAsk == true)
          )
        )
      );
    }

    // =============================================
    // USERS COLLECTION
    // [AUDIT FIX M-NEW-23] Prevent full profile enumeration and PII exposure
    // =============================================

    // Badge-engine fields denied on users/{uid} updates. The longer economy
    // denylist lives in profileUpdateBlocked(), inside that match. referredBy
    // stays out of this function: registerReferral owns it, and folding the
    // deny into one long && chain re-checks every helper and hits the
    // 1000-expression limit.
    function userProfileServerOnlyKeys() {
      return [
        'points', 'xp', 'weeklyXP', 'monthlyXP', 'level',
        'visibleBadges', 'hiddenBadges', 'badges', 'payingBadgeCount', 'badgeCounters',
        'marketListings', 'marketMessages', 'marketSold',
        'dailyTripleCount', 'trifectaDays', 'dailyFiveDays', 'dailyFiveStreak',
        'sayHiArmedDay', 'sayHiDays', 'replyBonusCount',
        'lastTriviaDate', 'lastPollDate', 'lastQuestDate', 'triviaStreak',
        'purpleTickets', 'blueTickets', 'pollDays',
        'chatCount', 'dmCount', 'beatsUploads', 'articlesPublished',
        'pvpPlayed', 'ciphersSolved', 'sfHashes', 'sfBlockSolver', 'sfContributions',
        'questDays', 'plebTalkSessions', 'tctvWatchDays', 'giftsSent', 'onboardingComplete',
        'lastShoutoutAt', 'predCorrect', 'predTotal', 'predLastResult',
        'flexTotals', 'flexAllDays', 'triviaCorrect', 'triviaStreakDay',
        'questsPassed', 'lqPassed', 'spinDays', 'spinStreak', 'spinHitRare',
        'spinClosetAwards', 'tipsVerified', 'tipsSentSats', 'tipsReceived',
        'raidDamageAllTime', 'raidBossesDefeated', 'raidWins', 'streakFreezesUsed',
        'giftsOpened', 'giftShoutoutWon', 'keyPeersDistinct', 'peerKeyCiphers',
        'cipherFullRing', 'cipherSatsPaid', 'cipherBiggestWin', 'peerBestLevel', 'peersAtL3',
        'topicComments', 'topicChannelsCommented', 'topicChannelCounts',
        'shopPurchases', 'raffleTicketsBought', 'raffleEntered', 'raffleWins',
        'predTopWeeks', 'predTopMonths', 'pushEnabled',
        'peerXpDay', 'peerXpCount', 'keyGiftXpDay', 'keyGiftXpCount',
        'topicCountDay', 'topicCountToday', 'topicXpDay', 'topicXpCount',
        'badgeBackfillToast',
        'certPassed_prop', 'certPassed_tech', 'certPassedAt_prop', 'certPassedAt_tech',
        'lastExamAttempt_prop', 'lastExamAttempt_tech',
        'scholar_exam_passed', 'scholar_tech_passed', 'scholar_tech_score',
        'email', 'emailHash', 'satsHold', 'emailHistory', 'emailHistoryHashes',
        'providersHash', 'providerHashes'
      ];
    }

    match /users/{userId} {
      // Reads:
      //   - Own profile: always allowed for the authenticated owner (get or list)
      //   - Leaderboard LIST queries: non-anonymous authenticated, limit <= 200
      //   - Individual profile GET (tapping a user in the leaderboard,
      //     chat, forum, etc.): non-anonymous authenticated only
      //   Anonymous sessions can only read their own document.
      //   [PII-FIX 2026-08-03] users collection is now owner-only.
      //   All leaderboard / profile lookups go through public_profiles (sanitized mirror).
      //   This closes the full-PII-dump vector: email, known_ips, fingerprint, etc.
      //   never leave the server-side CF functions or the owner's own session.
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false; // no client-side enumeration — use public_profiles
      // Create: allowlist the fields a client is permitted to set on initial doc creation.
      // Server-managed economy fields (points, streak, sats, tickets, etc.) default to 0 / empty
      // and must never be supplied by the client.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly([
                        // Identity / profile
                        'profilePic',
                        'displayName', 'country', 'lightning', 'lightningAddress',
                        'nostr', 'lastLogin', 'lastVisit', 'lastActive', 'isOnline',
                        // Safe zero-value seeds written by ranking.js on signup
                        // (we accept them only at their zero/empty initial values)
                        'points', 'channelsVisited', 'totalVisits', 'streak', 'created',
                        // Preferences
                        'nachoNickname', 'ghostMode', 'newsletterOptIn', 'newsletterOptInDate',
                        'celebratedState',
                        // TOS acceptance (written at signup)
                        'tosVersion', 'tosAcceptedAt',
                        // Signup attribution (written at signup)
                        'signupSource'
                    ])
                    // points / streak / channelsVisited must be 0 on create (never pre-seeded)
                    && (!('points'          in request.resource.data) || request.resource.data.points          == 0)
                    && (!('streak'          in request.resource.data) || request.resource.data.streak          <= 1)
                    && (!('channelsVisited' in request.resource.data) || request.resource.data.channelsVisited  == 0)
                    && (!('totalVisits'     in request.resource.data) || request.resource.data.totalVisits      <= 1)
                    && (!('lightning' in request.resource.data) || request.resource.data.lightning == '' || lnShape(request.resource.data.lightning))
                    && (!('lightningAddress' in request.resource.data) || request.resource.data.lightningAddress == '' || lnShape(request.resource.data.lightningAddress))
                    && (!('lightning' in request.resource.data) || !('lightningAddress' in request.resource.data)
                        || request.resource.data.lightning == '' || request.resource.data.lightningAddress == ''
                        || request.resource.data.lightning == request.resource.data.lightningAddress)
                    // created is optional: Nostr link and TOS acceptance can create a partial
                    // doc without it. When the field is sent, it must be the server clock.
                    // Signup, provider, Lightning, and Nostr profile creates send serverTimestamp().
                    && (!('created' in request.resource.data) || request.resource.data.created == request.time);

      // A denied field used to keep evaluating the lock helpers (&& does not
      // stop a long rule), which passes 1000 expressions. The ternary evaluates
      // only the taken branch: a server field is a plain false, and a normal
      // save validates just the keys in this write.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && (profileUpdateBlocked() ? false : profileShapeOk());

      function profileUpdateBlocked() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasAny([
            'referredBy', 'nachoQuestDone', 'introSeen', 'totpEnabled', 'introSeenAt', 'mergedAnon'
          ])
          || changed.hasAny(userProfileServerOnlyKeys())
          || changed.hasAny([
                        // Core economy
                        'points', 'xp', 'weeklyXP', 'monthlyXP', 'level',
                        'sats', 'satsEarned', 'satsWithdrawn', 'satsDisabled',
                        'orangeTickets', 'tickets',
                        // Timechain TV daily watch (tctvWatchHeartbeat only)
                        'tctvWatchSeconds', 'tctvWatchDay', 'tctvWatchLastCredit',
                        'tctvWatchAwardedDay', 'tctvWatchToastSeen',
                        // Streak / activity (CF-managed)
                        'streak', 'bestStreak', 'totalVisits', 'channelsVisited',
                        'readChannels', 'visitedChannelsList',
                        // Claim / withdrawal state
                        'pointsClaimed', 'pointsExchanged',
                        'lastSatsClaim', 'lastAwards', '_pendingClaim',
                        'withdrawals_disabled', 'pendingOverflow', 'lastOverflowDate',
                        'lastQuizDate', 'quizStreak', 'quizAnswered', 'quizCorrect',
                        'xpBankPayoutApplied', 'xpBankPayoutAmount', 'xpBankPayoutBank', 'xpBankPayoutAt',
                        // Shop inventory (spendTickets CF manages these)
                        'streakFreezes', 'hashBoosters', 'hashBoosterHashes',
                        'hintTokens', 'doubleXPCharges', 'doubleXPExpiry', 'doubleXpUntil',
                        'bonusSpins', 'raffleEntries', 'secondRigCharges',
                        // Bonus spin server flag (CF-only, one-time use)
                        'bonusSpinGranted',
                        'ownedCosmetics', 'spinClosetItems',
                        // Badges (awardPoints CF)
                        'badges', 'visibleBadges', 'hiddenBadges',
                        // Social / gamification counters (CF)
                        'forumPosts', 'forumReplies', 'lastSpinDate',
                        // Say-hi reward (armSayHi / claimSayHi). Server only.
                        'sayHiArmedDay', 'sayHiArmedAt',
                        'sayHiClaimedDay', 'sayHiClaimedMessageId', 'sayHiToastSeen',
                        // Reply bonus (claimReplyBonus). Server only. The first-reward
                        // flag lives in reply_bonus_state, never on this doc. These
                        // names are denied so a client cannot plant them.
                        'replyBonusClaimed', 'replyBonusFirstClaimed', 'replyBonusLastAt', 'replyBonusCount',
                        // Gifting system (CF-only)
                        'lastGiftSpinDate', 'giftsOpenedToday', 'giftsOpenedDate',
                        'lastShoutoutAt',
                        'ciphersDecryptedToday', 'ciphersDecryptedDate',
                        'keysSentDate', 'keysSentTo',
                        // Key provenance. sendKeys writes this on the key doc.
                        // A client cannot plant it on the profile either.
                        'sender',
                        'marketListings', 'marketMessages',
                        'referralTicketsEarned', 'referralCode', 'referralCount', 'referralInvited',
                        'referredBy', 'referralVerified', 'scholarPoints', 'activeDayKeys',
                        'tipChallengeDate', 'tipConfirmedDate',
                        'pointsDonated', 'donationBadges',
                        // Anonymous badge merge (CF-only, one-time guard)
                        'anonBadgesMerged',
                        // Premium — must never be client-writable (self-grant exploit)
                        'premium',
                        // Daily quest gating (CF)
                        'dailyAllThreeDate', 'dailyQuizDone', 'dailyTriviaDone', 'dailyPollDone',
                        // Admin / anti-fraud fields — NEVER writable by clients
                        'isAdmin', 'role', 'admin',
                        'banned', 'ban_reason', 'flagged', 'flag_reason',
                        'withdrawals_disabled', 'satsDisabled',
                        'known_ips', 'fingerprint', 'fraudScore',
                        // One-time Lightning address reset marker. Server only.
                        'ln_reset_used',
                        // Flex full-day counter (awardPoints only). Five Flex actions make a day.
                        'flexFullDays', 'flexFullDay',
                        // Faction is chosen by chooseFaction. Clients cannot plant it
                        // or a sync marker on the profile.
                        'faction', 'factionSynced', 'pointsSynced',
                        // Peer network (CF-only via managePeer)
                        'peers', 'peerCount',
                        // Peer partnership levels (CF-only via updatePeerLevelAfterGift)
                        'peerData',
                        // Immutable identity
                        'created', 'createdAt', 'uid',
                        // Price-prediction stats are server-only (resolvePredictions).
                        // The nested `predictions` map used to be client-incremented.
                        'predictions',
                        'pvpWins', 'pvpLosses',
                        'predCorrect', 'predTotal', 'predLastResult', 'predAccuracy',
                        'predPending', 'predStreak', 'predBestStreak', 'reachedAt', 'reachedSort',
                        'weekKey', 'weekCorrect', 'weekTotal', 'weekAccuracy', 'weekReachedAt', 'weekReachedSort',
                        'monthKey', 'monthCorrect', 'monthTotal', 'monthAccuracy', 'monthReachedAt', 'monthReachedSort',
                        'qualifiesAllTime', 'qualifiesWeek', 'qualifiesMonth',
                        // Identity is reserved by setUsername. Clients cannot claim a name
                        // or set or clear the repick flag.
                        'username', 'username_lower', 'usernameNeedsRepick',
                        // Onboarding completion and rewards are Cloud Function fields.
                        'onboardingQuest', 'nachoQuestDone', 'nachoQuestActive', 'nachoQuestStep',
                        'introSeen', 'introSeenAt',
                        // Guest-link nonce and the one-time merge marker.
                        'guestLinkNonce', 'guestLinkNonceAt', 'mergedInto', 'mergedFromGuest',
                        'usernameChangedAt',
                        'totpEnabled', 'phoneVerified',
                        // Push tokens stay in push_tokens/{uid}/devices, never on the profile
                        'fcmToken', 'pushToken', 'pushEnabled'
          ])
          // The client may clear a server-written leaderboard reward. It cannot set one.
          || (changed.hasAny(['pendingLeaderboardReward'])
              && 'pendingLeaderboardReward' in request.resource.data);
      }

      function profileShapeOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (!changed.hasAny(['username'])
            || !('username' in request.resource.data)
            || (request.resource.data.username is string
                && request.resource.data.username.size() >= 3
                && request.resource.data.username.size() <= 20
                && request.resource.data.username.matches('^[a-zA-Z0-9_\\-\\.\\s]+$')))
          && (!changed.hasAny(['displayBadge'])
            || !('displayBadge' in request.resource.data)
            || request.resource.data.displayBadge == ''
            || (request.resource.data.displayBadge is string
                && request.resource.data.displayBadge.size() <= 50
                && request.resource.data.displayBadge.matches('^[a-zA-Z0-9_\\-]+$')))
          && (!changed.hasAny(['equippedBadge'])
            || !('equippedBadge' in request.resource.data)
            || request.resource.data.equippedBadge == ''
            || (request.resource.data.equippedBadge is string
                && request.resource.data.equippedBadge.size() <= 50
                && request.resource.data.equippedBadge.matches('^[a-zA-Z0-9_\\-]+$')))
          // XSS prevention: country must be valid country-name chars
          && (!changed.hasAny(['country'])
            || !('country' in request.resource.data)
            || request.resource.data.country == ''
            || (request.resource.data.country is string
                && request.resource.data.country.size() >= 2
                && request.resource.data.country.size() <= 60
                && request.resource.data.country.matches("^[-a-zA-Z ,.()']+$")))
          // Home invite card. Owner may only store open, minimized, or dismissed.
          && (!changed.hasAny(['inviteCard'])
            || !('inviteCard' in request.resource.data)
            || request.resource.data.inviteCard == 'open'
            || request.resource.data.inviteCard == 'min'
            || request.resource.data.inviteCard == 'off')
          && (!changed.hasAny(['beatsShowUncensored'])
            || !('beatsShowUncensored' in request.resource.data)
            || request.resource.data.beatsShowUncensored == true
            || request.resource.data.beatsShowUncensored == false)
          && (!changed.hasAny(['lightning', 'lightningAddress', 'lnAddress']) || (true && lightningLockOk()))
          && (!changed.hasAny(['notificationPrefs']) || notificationPrefsOk())
          && (!changed.hasAny(['notifPrompt']) || notifPromptOk());
      }
      // Delete disabled: a client deleting then re-creating their doc would bypass all
      // field restrictions (the create allowlist only enforces zero-values but a second
      // create after delete could re-seed with anything). Server (Admin SDK) can still delete.
      allow delete: if false;

      // Sats withdrawal history (read own, Cloud Function writes)
      // Integrations (Strava, Lightning, etc.)
      match /integrations/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Proof of Walk data (read own, Cloud Function writes)
      match /proof_of_walk/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /proof_of_walk_stats/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /sats_withdrawals/{docId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId;
        allow write: if false; // Cloud Function only
      }

      // Sats daily tracking (Cloud Function only)
      match /sats_daily/{docId} {
        allow read, write: if false;
      }

      // Playlists subcollection
      match /playlists/{playlistId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 60;
        allow update: if request.auth != null
                      && request.auth.uid == userId;
        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }

      // Nook shop purchase history — owner read only, Cloud Function writes
      match /shop_purchases/{purchaseId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Cloud Function (Admin SDK) only
      }

      // Tip confirmations — one doc per UTC day. Cloud Function writes only.
      match /tip_confirmations/{dateId} {
        allow read, write: if false;
      }

      // Per-user in-app notifications (shop, exchange, etc.) — owner read/update, CF creates
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Owner can mark as read (update only); Cloud Function creates via Admin SDK
        allow update: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false; // Cloud Function (Admin SDK) only
      }
    }

    // =============================================
    // PUBLIC PROFILES — sanitized mirror of users
    // Synced server-side by syncPublicProfile CF trigger.
    // Never contains email, known_ips, fingerprint, or financial fields.
    // =============================================
    match /public_profiles/{uid} {
      // Any authenticated user (incl. anonymous) can read any public profile.
      // Writes are admin-SDK only (syncPublicProfile trigger). usernameNeedsRepick
      // cannot be set or cleared here either, because no client write is allowed.
      allow read: if request.auth != null;
      allow write: if false;
    }

    // =============================================
    // VISITS COLLECTION
    // =============================================
    match /visits/{visitorId} {
      allow read: if true; // visit counter needs to display for all users
      // [SECURITY FIX] create/update: enforce uid == visitorId so users can only write
      // their own visit doc. Previously any auth'd user could overwrite any visitor's
      // fingerprint field, enabling ban evasion by poisoning anti-fraud telemetry.
      // [SECURITY FIX H-2] Require auth and uid == visitorId on both create and update.
      // Previously create had no auth check at all, and update never verified uid == visitorId.
      // Any signed-in user could write/overwrite any visitor's fp, poisoning the ban signal.
      allow create: if request.auth != null
                    && request.auth.uid == visitorId
                    && request.resource.data.keys().hasOnly(['lastVisit', 'fp'])
                    && request.resource.data.lastVisit is string
                    && request.resource.data.lastVisit.size() == 10
                    && request.resource.data.fp is string
                    && request.resource.data.fp.size() <= 64;
      allow update: if request.auth != null
                    && request.auth.uid == visitorId
                    && request.resource.data.keys().hasOnly(['lastVisit', 'fp'])
                    && request.resource.data.lastVisit is string
                    && request.resource.data.lastVisit.size() == 10
                    && request.resource.data.lastVisit != resource.data.lastVisit
                    && request.resource.data.fp is string
                    && request.resource.data.fp.size() <= 64;
    }

    // =============================================
    // STATS COLLECTION
    // [AUDIT FIX S6] nacho-analytics now requires auth
    // =============================================
    match /stats/{statId} {
      allow read: if true;
      allow update: if request.auth != null
                    && statId == 'visits'
                    && request.resource.data.total == resource.data.total + 1;
      allow create: if request.auth != null
                    && statId == 'visits';
      // [AUDIT FIX S6 + LOW-4] nacho-analytics: non-anon auth + field allowlist to prevent junk data
      // Only whitelisted increment fields accepted; no arbitrary keys.
      allow create, update: if statId == 'nacho-analytics'
                            && request.auth != null
                            && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                            && request.resource.data.keys().hasOnly([
                                'totalQuestions', 'upvotes', 'downvotes', 'lastUpdated',
                                'topics', 'sources'
                            ]);
      // Community prediction totals (stats/predictions) are written only by
      // resolvePredictions via the Admin SDK. The old client +1 rules are
      // closed so a hostile client cannot inflate community accuracy.
      // No allow matches statId == 'predictions', so client writes are denied.
      // Read stays open via `allow read: if true` above.
      // ─── Global community stats ───
      // Authenticated (non-anonymous) users may increment whitelisted counters
      // by exactly +1 per write (watchTimeMinutes allows +1..+5 for batched TCTV pings).
      // Admin emails have unrestricted write (for resets and maintenance).
      //
      // Whitelisted fields: channelVisits, questsCompleted, chatMessages, spins,
      //                     userCount, watchTimeMinutes
      // pvpMatches is incremented only by onPvpMatchFinished.
      //
      // Risk: a determined attacker with a console can inflate counters, but these
      // are cosmetic engagement metrics only — no points, sats, or access granted.
      // Worst case: admin calls resetCommunityStats() to reset.
      // Cosmetic engagement counters only — no points, sats, or access.
      allow update, create: if statId == 'global'
                             && request.auth != null
                             && isAdmin();
      // Per-field +1 increments for non-admin authenticated users.
      // Writes must touch exactly ONE whitelisted field; the value must equal
      // the previous value + 1 (or +1..+5 for watchTimeMinutes — allows small batched TCTV ticks).
      allow update: if statId == 'global'
                    && request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && (
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['channelVisits'])
                        && request.resource.data.channelVisits == resource.data.get('channelVisits', 0) + 1)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['questsCompleted'])
                        && request.resource.data.questsCompleted == resource.data.get('questsCompleted', 0) + 1)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatMessages'])
                        && request.resource.data.chatMessages == resource.data.get('chatMessages', 0) + 1)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spins'])
                        && request.resource.data.spins == resource.data.get('spins', 0) + 1)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userCount'])
                        && request.resource.data.userCount == resource.data.get('userCount', 0) + 1)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['watchTimeMinutes'])
                        && request.resource.data.watchTimeMinutes >= resource.data.get('watchTimeMinutes', 0) + 1
                        && request.resource.data.watchTimeMinutes <= resource.data.get('watchTimeMinutes', 0) + 5)
                    );
      // Create when doc doesn't exist — same pattern, diff against empty fallback
      allow create: if statId == 'global'
                    && request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.keys()
                       .hasOnly(['channelVisits','questsCompleted','chatMessages','spins','userCount','watchTimeMinutes'])
                    && request.resource.data.keys().size() == 1
                    && request.resource.data.values()[0] is int
                    && request.resource.data.values()[0] >= 1
                    && request.resource.data.values()[0] <= 5;
    }

    // Active predictions (for server-side resolution)
    // [AUDIT FIX L-NEW-11] Prevent backdating predictions.
    // hasOnly rejects a client-supplied serverStartPrice, void, or any other key.
    // resolved must be false so the open prediction is eligible for scoring.
    match /active_predictions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.keys().hasOnly(['uid', 'direction', 'price', 'time', 'resolved'])
                    && request.resource.data.resolved == false
                    && request.resource.data.direction is string
                    && (request.resource.data.direction == 'up' || request.resource.data.direction == 'down')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.price > 0
                    && request.resource.data.time == request.time;
      // No updates allowed — predictions are immutable once placed
      allow update: if false;
      // Clients must not delete a prediction to dodge server scoring.
      allow delete: if false;
    }

    // Per-user prediction stats. Owner can read their own doc (the price card
    // and the qualification line). Clients cannot write any field.
    match /prediction_stats/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Immutable resolved predictions. Owner may read their own history.
    match /prediction_records/{recordId} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Weekly/monthly Top Predictors payout lock. Server only.
    match /prediction_payouts/{periodId} {
      allow read, write: if false;
      match /winners/{winnerId} {
        allow read, write: if false;
      }
    }

    // Server-fetched start price for one prediction. Document id is {uid}_{time}.
    // Clients cannot read or write it. The resolver scores only a doc that has
    // serverPriceSetAt, which only the Admin SDK sets.
    match /prediction_server/{docId} {
      allow read, write: if false;
    }

    // =============================================
    // SUGGESTIONS COLLECTION
    // [AUDIT FIX L-NEW-4] Enforce 1 suggestion per user via document ID
    // =============================================
    match /suggestions/{suggestionId} {
      allow read: if false;
      allow create: if request.auth != null
                    && suggestionId == request.auth.uid
                    && request.resource.data.keys().hasAny(['text', 'suggestion'])
                    && ((request.resource.data.get('suggestion', '') is string && request.resource.data.get('suggestion', '').size() <= 1000)
                       || (request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 1000));
      allow update: if request.auth != null
                    && suggestionId == request.auth.uid
                    && request.resource.data.keys().hasAny(['text', 'suggestion'])
                    && ((request.resource.data.get('suggestion', '') is string && request.resource.data.get('suggestion', '').size() <= 1000)
                       || (request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 1000));
    }

    // =============================================
    // REFERRALS COLLECTION
    // [AUDIT FIX M-NEW-24] Prevent fake referral creation 
    // Format: docId is the UID of the new user being referred
    // =============================================
    match /referrals/{referralId} {
      // The two parties only. A referrerCode query cannot be proven by this
      // rule, so the client filters on referrerUid.
      allow read: if request.auth != null
                  && (resource.data.referrerUid == request.auth.uid
                      || resource.data.referredUserUid == request.auth.uid);
      // Created and paid only by Cloud Functions. Clients cannot write a
      // referral, verify it, or award tickets.
      allow create, update, delete: if false;
    }

    // Signup IP and other fraud signals. Admin SDK only.
    match /referral_signals/{signalId} {
      allow read, write: if false;
    }

    // Hourly pending-referral cursor. Admin SDK only.
    match /referral_scan/{docId} {
      allow read, write: if false;
    }

    // Referral code index. Server writes one doc per user. Clients cannot
    // mint or overwrite a code.
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    match /tip_confirmations/{docId} {
      allow read, write: if false;
    }

    // Payment hashes that already earned tip XP. Admin SDK only.
    match /tip_hashes/{hashId} {
      allow read, write: if false;
    }

    // Server-fetched tip invoices and the per-pair daily badge cap. Admin SDK only.
    match /tip_invoices/{hashId} {
      allow read, write: if false;
    }
    match /tip_pair_days/{docId} {
      allow read, write: if false;
    }

    // Paid-referral timestamps used for the per-referrer cap. Admin SDK only.
    match /referral_pay_limits/{uid} {
      allow read, write: if false;
    }

    // =============================================
    // GIVEAWAY ENTRIES
    // =============================================
    match /giveaway_entries/{entryId} {
      allow read: if false;
      // [AUDIT FIX H-3] One entry per user — force entryId == uid so duplicates are impossible
      allow create: if request.auth != null
                    && entryId == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && entryId == request.auth.uid
                    && resource.data.uid == request.auth.uid;
    }

    // =============================================
    // PUSH TOKENS
    // =============================================
    // Per-user token index. The parent doc is server-managed.
    // Devices are owner-only: another user cannot read or write the token.
    match /push_tokens/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // The parent doc must exist so broadcasts can list devices.
      // Clients may only touch updatedAt. Tokens live on devices/{deviceId}.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['updatedAt'])
                    && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
                    && request.resource.data.updatedAt == request.time;

      match /devices/{deviceId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
                              && request.auth.uid == uid
                              && deviceId.matches('^[A-Za-z0-9_\\-]{8,64}$')
                              && request.resource.data.keys().hasOnly(['token', 'updatedAt', 'platform', 'ua'])
                              && request.resource.data.token is string
                              && request.resource.data.token.size() >= 20
                              && request.resource.data.token.size() <= 512
                              && request.resource.data.updatedAt == request.time
                              && request.resource.data.platform is string
                              && request.resource.data.platform.size() <= 40
                              && request.resource.data.ua is string
                              && request.resource.data.ua.size() <= 160;
      }
    }

    // =============================================
    // TOTP SECRETS (Cloud Functions only)
    // =============================================
    match /totp_pending/{userId} {
      allow read, write: if false;
    }
    match /totp_secrets/{userId} {
      allow read, write: if false;
    }
    match /totp_rate_limits/{userId} {
      allow read, write: if false; // Cloud Function only
    }
    match /totp_sessions/{docId} {
      allow read, write: if false;
    }
    match /trusted_devices/{docId} {
      allow read, write: if false;
    }
    match /totp_fresh_proofs/{docId} {
      allow read, write: if false;
    }
    match /recovery_codes/{docId} {
      allow read, write: if false;
    }
    match /mfa_admin_log/{docId} {
      allow read, write: if false;
    }

    // =============================================
    // FORUM POSTS
    // [AUDIT FIX S5] Upvote tracking with voter deduplication
    // =============================================
    // Topic cross-posts are Admin SDK writes. Clients cannot set the mirror
    // fields, the paragraph anchor, authorId, hidden, or deleted on a mirrored
    // doc. The author of a mirrored doc may change only body, and only while
    // it is still visible. Ordinary Pleb Talk posts are not paced by
    // topic_discussion_limits. anchorIndex and anchorHash are server-written
    // scroll hints; clients cannot create or change them.
    function forumMirrorFieldsAbsent() {
      return !request.resource.data.keys().hasAny(['origin', 'mirrorOf', 'mirrorSync', 'topicChannel', 'topicPost', 'topicLink', 'anchorIndex', 'anchorHash', 'noAward', 'mirrored']);
    }
    function forumMirrorFieldsFrozen() {
      return request.resource.data.get('origin', null) == resource.data.get('origin', null)
        && request.resource.data.get('mirrorOf', null) == resource.data.get('mirrorOf', null)
        && request.resource.data.get('mirrorSync', null) == resource.data.get('mirrorSync', null)
        && request.resource.data.get('topicChannel', null) == resource.data.get('topicChannel', null)
        && request.resource.data.get('topicPost', null) == resource.data.get('topicPost', null)
        && request.resource.data.get('topicLink', null) == resource.data.get('topicLink', null)
        && request.resource.data.get('anchorIndex', null) == resource.data.get('anchorIndex', null)
        && request.resource.data.get('anchorHash', null) == resource.data.get('anchorHash', null)
        && request.resource.data.get('noAward', null) == resource.data.get('noAward', null)
        && request.resource.data.get('mirrored', null) == resource.data.get('mirrored', null)
        && request.resource.data.authorId == resource.data.authorId;
    }
    function forumMirroredDoc() {
      return resource.data.get('origin', '') == 'topic'
        || resource.data.get('origin', '') == 'forum'
        || resource.data.get('noAward', false) == true
        || resource.data.get('mirrorOf', '') != ''
        || resource.data.get('mirrored', false) == true
        || ('mirrorSync' in resource.data)
        || ('topicChannel' in resource.data)
        || ('topicPost' in resource.data)
        || ('topicLink' in resource.data);
    }
    function forumAuthorMayUpdate(maxBody) {
      return resource.data.authorId == request.auth.uid
        && (
          !forumMirroredDoc()
          || (
            resource.data.get('hidden', false) != true
            && resource.data.get('deleted', false) != true
            && request.resource.data.get('hidden', false) == resource.data.get('hidden', false)
            && request.resource.data.get('deleted', false) == resource.data.get('deleted', false)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 2
            && request.resource.data.body.size() <= maxBody
          )
        );
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['title', 'authorId', 'authorName', 'createdAt'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 5
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.authorId == request.auth.uid
                    && forumMirrorFieldsAbsent();
      allow update: if request.auth != null
                    && (
                      isAdmin()
                      || (
                        forumMirrorFieldsFrozen()
                        && (
                      // Upvote: only if user hasn't voted yet, increment by exactly 1, append only own UID
                      // Upvote: +1, no replyCount manipulation
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'voters'])
                       && (!(request.auth.uid in resource.data.get('voters', [])))
                       && request.resource.data.upvotes == resource.data.get('upvotes', 0) + 1
                       && request.resource.data.voters.size() == resource.data.get('voters', []).size() + 1
                       && request.auth.uid in request.resource.data.voters
                      )
                      // Un-vote: only if user HAS voted, decrement by exactly 1, remove only own UID
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'voters'])
                       && (request.auth.uid in resource.data.get('voters', []))
                       && request.resource.data.upvotes == resource.data.get('upvotes', 0) - 1
                       && request.resource.data.voters.size() == resource.data.get('voters', []).size() - 1
                       && !(request.auth.uid in request.resource.data.voters)
                      )
                      || forumAuthorMayUpdate(2000)
                        )
                      )
                    );
      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || isAdmin());
    }

    // =============================================
    // FORUM REPLIES
    // =============================================
    match /forum_replies/{replyId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['postId', 'body', 'authorId', 'authorName', 'createdAt'])
                    && request.resource.data.body is string
                    && request.resource.data.body.size() >= 2
                    && request.resource.data.body.size() <= 1000
                    && request.resource.data.authorId == request.auth.uid
                    && forumMirrorFieldsAbsent();
      allow update: if request.auth != null
                    && (
                      isAdmin()
                      || (
                        forumMirrorFieldsFrozen()
                        && (
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'voters'])
                       && (!(request.auth.uid in resource.data.get('voters', [])))
                       && request.resource.data.upvotes == resource.data.get('upvotes', 0) + 1
                       && request.resource.data.voters.size() == resource.data.get('voters', []).size() + 1
                       && request.auth.uid in request.resource.data.voters)
                      || forumAuthorMayUpdate(1000)
                        )
                      )
                    );
      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || isAdmin());
    }

    // Listing photo: https URL, or a jpeg/png/webp data URL. Blocks javascript: and other schemes.
    function marketImageValueOk(url) {
      return url == null
        || (url is string
            && url.size() <= 700000
            && (url.matches('^https://[^\\s"<>]+$')
                || url.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')));
    }

    function marketCategoryOk(v) {
      return v in ['books','courses','hardware_edu','nodes','kids','tools','edu_other','mining','merch','art','stickers','services','electronics','other'];
    }

    function marketConditionOk(v) {
      return v in ['new','like_new','good','fair','for_parts'];
    }

    // sellerName must be the profile username. A missing user doc, a missing
    // username, or an empty username may only publish an empty sellerName.
    function marketUsernameOk(username, name) {
      return (username is string && username.size() > 0 && name == username)
        || ((!(username is string) || username.size() == 0) && name == '');
    }

    function marketSellerNameMatches() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let name = request.resource.data.get('sellerName', '');
      return (!exists(userPath) && name == '')
        || (exists(userPath) && marketUsernameOk(get(userPath).data.get('username', ''), name));
    }

    // Owner edit. sellerUid, views, saves, and createdAt stay put.
    // Status may move active → sold, active → deleted, or sold → deleted.
    // Deleted is final for the owner (an admin restores through isAdmin()).
    // Price, title, and other content change only while the listing stays active.
    // Content edits stamp updatedAt with request.time. Soft-delete stamps
    // deletedAt with request.time. deletedBy is the caller's uid. The live
    // client still sends the literals 'owner' and 'admin' until that build
    // ships, so those two strings are accepted from the owner as well.
    // A sale is status 'sold' only: deletedAt stays unset, so a Nacho
    // listing shoutout remains. Status 'deleted' is what retracts it.
    function marketDeletedByOk(by) {
      return by == request.auth.uid || by == 'owner' || by == 'admin';
    }

    function marketOwnerEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      let oldStatus = resource.data.get('status', 'active');
      let newStatus = d.get('status', oldStatus);
      return resource.data.sellerUid == request.auth.uid
        && oldStatus != 'deleted'
        && changed.hasOnly(['title','description','priceSats','category','condition','imageUrl','lightningAddress','shipping','local','localPickup','status','updatedAt','deletedBy','deletedAt'])
        && d.get('sellerUid', '') == resource.data.get('sellerUid', '')
        && d.get('views', 0) == resource.data.get('views', 0)
        && d.get('saves', 0) == resource.data.get('saves', 0)
        && d.get('createdAt', null) == resource.data.get('createdAt', null)
        && (!changed.hasAny(['title']) || (d.title is string && d.title.size() >= 3 && d.title.size() <= 80))
        && (!changed.hasAny(['description']) || (d.description is string && d.description.size() <= 1000))
        && (!changed.hasAny(['priceSats']) || (d.priceSats is int && d.priceSats >= 1 && d.priceSats <= 100000000000))
        && (!changed.hasAny(['category']) || marketCategoryOk(d.category))
        && (!changed.hasAny(['condition']) || marketConditionOk(d.condition))
        && (!changed.hasAny(['imageUrl']) || marketImageValueOk(d.imageUrl))
        && (!changed.hasAny(['lightningAddress']) || d.lightningAddress == null || (d.lightningAddress is string && d.lightningAddress.size() <= 120))
        && (!changed.hasAny(['shipping']) || d.shipping is bool)
        && (!changed.hasAny(['local']) || d.local is bool)
        && (!changed.hasAny(['localPickup']) || d.localPickup is bool)
        // Deleting status must not look like "status unchanged": get() would
        // fall back to the old value, so the field has to stay a string.
        && (!changed.hasAny(['status']) || d.status is string)
        && (newStatus == oldStatus
            || (oldStatus == 'active' && (newStatus == 'sold' || newStatus == 'deleted'))
            || (oldStatus == 'sold' && newStatus == 'deleted'))
        && (!changed.hasAny(['title','description','priceSats','category','condition','imageUrl','lightningAddress','shipping','local','localPickup','updatedAt'])
            || (oldStatus == 'active' && newStatus == 'active' && d.updatedAt == request.time))
        && (!changed.hasAny(['deletedBy','deletedAt']) || newStatus == 'deleted')
        && (newStatus != 'deleted'
            || (marketDeletedByOk(d.deletedBy) && d.deletedAt == request.time));
    }

    // An owner may hard-delete an active, sold, or self-removed listing.
    // A listing an admin removed stays in place so the moderation record
    // survives. deletedBy 'admin', 'admin-mod', or another uid blocks the
    // owner. moderated, moderationHidden, and hidden do too. The admin
    // custom claim can still hard-delete it.
    function marketOwnerHardDelete() {
      return resource.data.sellerUid == request.auth.uid
        && resource.data.get('moderated', false) != true
        && resource.data.get('moderationHidden', false) != true
        && resource.data.get('hidden', false) != true
        && (resource.data.get('status', 'active') != 'deleted'
            || resource.data.get('deletedBy', '') == request.auth.uid
            || resource.data.get('deletedBy', '') == 'owner');
    }

    // Detail view: any signed-in user may add exactly 1 to views.
    function marketViewBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is int
        && request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    // Save or unsave. saves moves by exactly 1, and savedBy gains or loses
    // only the caller's uid. A uid already in savedBy cannot save again.
    function marketSaveToggle() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldSaved = resource.data.get('savedBy', []);
      let newSaved = request.resource.data.savedBy;
      let uid = request.auth.uid;
      return changed.hasOnly(['saves', 'savedBy'])
        && oldSaved is list
        && newSaved is list
        && request.resource.data.saves is int
        && (
          (!(uid in oldSaved)
            && (uid in newSaved)
            && newSaved.hasAll(oldSaved)
            && newSaved.size() == oldSaved.size() + 1
            && request.resource.data.saves == resource.data.get('saves', 0) + 1)
          || ((uid in oldSaved)
            && !(uid in newSaved)
            && oldSaved.hasAll(newSaved)
            && newSaved.size() == oldSaved.size() - 1
            && request.resource.data.saves == resource.data.get('saves', 0) - 1
            && request.resource.data.saves >= 0)
        );
    }

    // =============================================
    // MARKETPLACE LISTINGS
    // =============================================
    match /marketplace/{listingId} {
      allow read: if true;
      // Client payload from marketplace.js submitListing(). sellerName is the
      // profile username (or empty when that username is missing).
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && listingId.matches('^[A-Za-z0-9]{20}$')
                    && request.resource.data.keys().hasOnly(['title','description','priceSats','category','condition','imageUrl','lightningAddress','shipping','localPickup','sellerUid','sellerName','sellerRank','status','views','saves','createdAt'])
                    && request.resource.data.keys().hasAll(['title','priceSats','category','sellerUid','status','views','saves','createdAt'])
                    && request.resource.data.sellerUid == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.views == 0
                    && request.resource.data.saves == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 80
                    && request.resource.data.get('description', '') is string
                    && request.resource.data.get('description', '').size() <= 1000
                    && request.resource.data.priceSats is int
                    && request.resource.data.priceSats >= 1 && request.resource.data.priceSats <= 100000000000
                    && marketCategoryOk(request.resource.data.category)
                    && marketConditionOk(request.resource.data.get('condition', 'good'))
                    && marketImageValueOk(request.resource.data.get('imageUrl', null))
                    && (request.resource.data.get('lightningAddress', null) == null
                        || (request.resource.data.lightningAddress is string
                            && request.resource.data.lightningAddress.size() <= 120))
                    && request.resource.data.get('shipping', false) is bool
                    && request.resource.data.get('localPickup', false) is bool
                    && request.resource.data.get('sellerName', '') is string
                    && request.resource.data.get('sellerName', '').size() <= 40
                    && marketSellerNameMatches()
                    && request.resource.data.get('sellerRank', '') is string
                    && request.resource.data.get('sellerRank', '').size() <= 40;
      allow update: if request.auth != null
                    && (marketOwnerEdit()
                        || isAdmin()
                        || marketViewBump()
                        || marketSaveToggle());
      allow delete: if request.auth != null
                    && (marketOwnerHardDelete()
                        || isAdmin());
    }

    // =============================================
    // MARKETPLACE MESSAGES
    // =============================================
    match /marketplace_messages/{msgId} {
      allow read: if request.auth != null
                  && (resource.data.buyerUid == request.auth.uid
                      || resource.data.sellerUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.buyerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['buyerUid', 'sellerUid', 'listingId', 'message']);
    }

    // =============================================
    // DIRECT MESSAGES
    // =============================================
    match /dm_conversations/{convoId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    // participantNames values must be strings ≤ 60 chars; no injecting arbitrary values
                    && (!('participantNames' in request.resource.data)
                        || (request.resource.data.participantNames is map
                            && request.resource.data.participantNames.keys().hasOnly(request.resource.data.participants)
                            && request.resource.data.participantNames.values().toSet().size() <= 2));
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'participantNames', 'createdAt']);

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/dm_conversations/$(convoId)).data.participants;
        allow create: if request.auth != null
                      && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                      && request.auth.uid in get(/databases/$(database)/documents/dm_conversations/$(convoId)).data.participants
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 1000
                      && !('isNachoAuto' in request.resource.data)
                      && (request.resource.data.text.size() >= 1 || ('imageUrl' in request.resource.data && request.resource.data.imageUrl is string && request.resource.data.imageUrl.matches('^https://.*')))
                      && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.matches('^https://.*')));
      }
    }

    // =============================================
    // REPORTS
    // =============================================
    match /reports/{reportId} {
      allow read: if request.auth != null
                  && isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid;
    }

    // =============================================
    // IRL EVENTS
    // =============================================
    match /irl_events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid
                    && request.resource.data.keys().hasAll(['title', 'hostId', 'date'])
                    && (request.resource.data.keys().hasAny(['location', 'locationName']))
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 3
                    && request.resource.data.title.size() <= 200
                    // link field must be https:// or absent — blocks javascript: and data: XSS
                    && (!request.resource.data.keys().hasAny(['link'])
                        || (request.resource.data.link is string
                            && request.resource.data.link.matches('https://.*')));
      allow update: if request.auth != null
                    && (resource.data.hostId == request.auth.uid
                        || isAdmin()
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees'])
                            && request.resource.data.attendees.size() == resource.data.get('attendees', []).size() + 1
                            && request.auth.uid in request.resource.data.attendees))
                    // link field must be https:// or absent on update too
                    && (!request.resource.data.keys().hasAny(['link'])
                        || request.resource.data.link == null
                        || (request.resource.data.link is string
                            && request.resource.data.link.matches('https://.*')));
      allow delete: if request.auth != null
                    && (resource.data.hostId == request.auth.uid
                        || isAdmin());
    }

    // =============================================
    // CHANNEL RATINGS
    // [AUDIT FIX L-NEW-5] Enforce per-user deduplication
    // =============================================
    match /channel_ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null
                    && ratingId == request.resource.data.channelId + '_' + request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && ratingId == resource.data.channelId + '_' + request.auth.uid
                    && resource.data.userId == request.auth.uid;
    }

    // =============================================
    // PVP LOBBY
    // [AUDIT FIX L-NEW-7] Enforce 1 entry per user via document ID
    // =============================================
    function pvpPicOk(url) {
      return url is string
             && url.size() <= 400
             && (url == ''
                 || url.matches('https://firebasestorage\\.googleapis\\.com/.*')
                 || url.matches('https://[a-z0-9-]+\\.firebasestorage\\.app/.*')
                 || url.matches('https://assets\\.bitcoineducation\\.quest/.*')
                 || url.matches('https://lh3\\.googleusercontent\\.com/.*'));
    }

    match /pvp_lobby/{docId} {
      allow read: if request.auth != null;
      // Signed-in, non-anonymous, own uid, strict field list. No extra payload.
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && docId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'profilePic', 'status', 'createdAt', 'lastSeen'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.name.matches('[^\\[\\]()@#*`_]+')
                    && pvpPicOk(request.resource.data.profilePic)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.lastSeen is number
                    && request.resource.data.lastSeen <= request.time.toMillis() + 5000
                    && request.resource.data.lastSeen >= request.time.toMillis() - 120000;
      // Heartbeat only, and not faster than once every 4 seconds.
      allow update: if request.auth != null
                    && docId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
                    && request.resource.data.lastSeen is number
                    && request.resource.data.lastSeen >= resource.data.lastSeen + 4000
                    && request.resource.data.lastSeen <= request.time.toMillis() + 5000;
      allow delete: if request.auth != null
                    && docId == request.auth.uid;
    }

    // One summary of who is waiting. Clients listen to this doc only.
    // onPvpLobbyLive maintains it. Clients cannot write it.
    match /pvp_lobby_live/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /pvp_rewards/{matchId} {
      allow read, write: if false;
    }

    match /pvp_rate/{uid} {
      allow read, write: if false;
    }

    // =============================================
    // PVP MATCHES
    // [AUDIT FIX S4] Validate player1 is the creator
    // =============================================
    // PVP answer keys — server-only, no client access
    match /pvp_answer_keys/{matchId} {
      allow read, write: if false;
    }

    // Scholar exam answer keys — server-only, no client access
    match /scholar_exam_keys/{examId} {
      allow read, write: if false;
    }

    // Quest answer keys — server-only, no client access
    match /quest_answer_keys/{questId} {
      allow read, write: if false;
    }

    match /pvp_matches/{matchId} {
      allow read: if request.auth != null
                  && (resource.data.player1.uid == request.auth.uid
                      || resource.data.player2.uid == request.auth.uid);
      // Matches are created by pvpCreateMatch (admin SDK). Clients cannot
      // plant a questions array or an answer key.
      allow create: if false;
      // No client writes once the match is finished or forfeited.
      // player1 and player2 are server-owned (uids live in pvp_answer_keys).
      // A client may forfeit only as itself, and only with manual_leave.
      // questionWinner may be cleared to null. The timer moves only when a round starts.
      allow update: if request.auth != null
                    && (resource.data.player1.uid == request.auth.uid
                        || resource.data.player2.uid == request.auth.uid)
                    && resource.data.status in ['countdown', 'active', 'question_result']
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'currentQ', 'questionWinner', 'questionStartedAt',
                                 'player1LastSeen', 'player2LastSeen',
                                 'forfeitedBy', 'forfeitReason', 'lastTaunt'])
                    && (request.resource.data.status == resource.data.status
                        || (request.resource.data.status == 'active'
                            && resource.data.status in ['countdown', 'question_result'])
                        || (request.resource.data.status == 'forfeit'
                            && request.resource.data.forfeitedBy == request.auth.uid
                            && request.resource.data.forfeitReason == 'manual_leave'))
                    && (request.resource.data.currentQ == resource.data.currentQ
                        || (resource.data.status == 'question_result'
                            && request.resource.data.status == 'active'
                            && request.resource.data.currentQ == resource.data.currentQ + 1))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['questionWinner'])
                        || request.resource.data.questionWinner == null)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['questionStartedAt'])
                        || (request.resource.data.status == 'active'
                            && request.resource.data.status != resource.data.status
                            && request.resource.data.questionStartedAt == request.time))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['forfeitedBy', 'forfeitReason'])
                        || (request.resource.data.status == 'forfeit'
                            && request.resource.data.forfeitedBy == request.auth.uid
                            && request.resource.data.forfeitReason == 'manual_leave'))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastTaunt'])
                        || (request.resource.data.lastTaunt.uid == request.auth.uid
                            && request.resource.data.lastTaunt.emoji is string
                            && request.resource.data.lastTaunt.emoji.size() > 0
                            && request.resource.data.lastTaunt.emoji.size() <= 8
                            && request.resource.data.lastTaunt.ts is number));
    }

    // =============================================
    // BITCOIN BEATS — TRACKS
    // =============================================
    match /beats_tracks/{trackId} {
      allow read: if true;
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.copyrightConfirmed == true
                    // Minimum 15-second duration — server-side enforcement so client
                    // duration check can't be bypassed. duration is written in seconds
                    // by the client after reading HTMLAudioElement metadata.
                    && 'duration' in request.resource.data
                    && request.resource.data.duration is int
                    && request.resource.data.duration >= 15
                    && (!('coverUrl' in request.resource.data)
                        || request.resource.data.coverUrl == ''
                        || request.resource.data.coverUrl == null
                        || request.resource.data.coverUrl.matches('^https://.*')
                        || request.resource.data.coverUrl.matches('^data:image/.*'))
                    // XSS prevention: genre must be plain alphanumeric + spaces/hyphens only
                    && (!('genre' in request.resource.data)
                        || request.resource.data.genre == ''
                        || (request.resource.data.genre is string
                            && request.resource.data.genre.size() <= 30
                            && request.resource.data.genre.matches('^[a-zA-Z0-9 \\-_&/]+$')))
                    // XSS prevention: releaseDate must be YYYY-MM-DD format only
                    && (!('releaseDate' in request.resource.data)
                        || request.resource.data.releaseDate == ''
                        || (request.resource.data.releaseDate is string
                            && request.resource.data.releaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      allow update: if request.auth != null
                    && (
                      // Author can update their own track (with coverUrl + XSS validation)
                      (resource.data.authorId == request.auth.uid
                        && (!('coverUrl' in request.resource.data)
                            || request.resource.data.coverUrl == ''
                            || request.resource.data.coverUrl == null
                            || request.resource.data.coverUrl.matches('^https://.*')
                            || request.resource.data.coverUrl.matches('^data:image/.*'))
                        && (!('genre' in request.resource.data)
                            || request.resource.data.genre == ''
                            || (request.resource.data.genre is string
                                && request.resource.data.genre.size() <= 30
                                && request.resource.data.genre.matches('^[a-zA-Z0-9 \\-_&/]+$')))
                        && (!('releaseDate' in request.resource.data)
                            || request.resource.data.releaseDate == ''
                            || (request.resource.data.releaseDate is string
                                && request.resource.data.releaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
                      // Social interactions: plays/likes only
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays', 'likes', 'likedBy'])
                          && request.resource.data.plays <= resource.data.get('plays', 0) + 1
                          && request.resource.data.likes <= resource.data.get('likes', 0) + 1
                          && (!request.resource.data.keys().hasAny(['likedBy']) || (
                              request.resource.data.likedBy is list
                              && request.resource.data.likedBy.size() <= resource.data.get('likedBy', []).size() + 1
                              && request.resource.data.likedBy.hasAll(resource.data.get('likedBy', []))
                              && !(resource.data.get('likedBy', []).hasAny([request.auth.uid]))
                          )))
                    )
                    // Moderated tracks stay hidden. A partial update (plays, likes,
                    // title) still sees the existing flag. A rewrite that drops it,
                    // or sets hidden to anything other than true, is rejected, so an
                    // import cannot un-hide the doc.
                    && (resource.data.get('hidden', false) != true
                        || request.resource.data.hidden == true);
      allow delete: if request.auth != null
                    && (
                      isAdmin()
                      || (resource.data.authorId == request.auth.uid
                          && resource.data.get('hidden', false) != true)
                    );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 280;
        allow delete: if request.auth != null
                      && resource.data.authorId == request.auth.uid;
      }
    }

    // =============================================
    // BITCOIN BEATS — V4V ARTISTS
    // =============================================
    match /beats_artists/{artistId} {
      allow read: if true;
      // Only admin can create/update (import script uses Admin SDK)
      allow write: if request.auth != null
                   && isAdmin();
    }

    // =============================================
    // BITCOIN BEATS — V4V SPLIT EVENTS (log)
    // =============================================
    match /beats_v4v_events/{eventId} {
      allow read: if request.auth != null
                  && isAdmin();
      allow write: if false; // written by Cloud Function only
    }

    // =============================================
    // BITCOIN BEATS — REPORTS
    // =============================================
    match /beats_reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // =============================================
    // LNURL-AUTH CHALLENGES
    // =============================================
    match /lnauth_challenges/{k1} {
      allow read, write: if false;
    }

    // =============================================
    // ARTICLES
    // =============================================
    match /articles/{articleId} {
      allow read: if true;
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 10
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.body is string
                    && request.resource.data.agreedToTerms == true;
      allow update: if request.auth != null
                    && (
                      // Author can edit their own article
                      resource.data.authorId == request.auth.uid
                      // Upvotes/tips/saves: anyone authenticated
                      // [SECURITY FIX] Each branch now freezes the fields it does NOT own.
                      // Previously the OR logic let any branch pass while the caller freely
                      // wrote the other fields: e.g. tip branch only checked tipTotal > current,
                      // so an attacker could include tipTotal+1 AND zero out upvotes/voters/saves.
                      || (
                          // Upvote: only upvotes + voters change
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'voters'])
                          && !(request.auth.uid in resource.data.get('voters', []))
                          && request.resource.data.upvotes == resource.data.get('upvotes', 0) + 1
                          && request.resource.data.voters.size() == resource.data.get('voters', []).size() + 1
                          && request.auth.uid in request.resource.data.voters
                      )
                      || (
                          // Save: only saves + savedBy change
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saves', 'savedBy'])
                          && !(request.auth.uid in resource.data.get('savedBy', []))
                          && request.resource.data.saves == resource.data.get('saves', 0) + 1
                          && request.resource.data.savedBy.size() == resource.data.get('savedBy', []).size() + 1
                          && request.auth.uid in request.resource.data.savedBy
                      )
                      || (
                          // Tip: only tipTotal changes, must strictly increase
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipTotal'])
                          && request.resource.data.tipTotal > resource.data.get('tipTotal', 0)
                      )
                      // Admin
                      || isAdmin()
                    );
      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || isAdmin());
    }

    // =============================================
    // ARTICLE REPLIES
    // =============================================
    match /article_replies/{replyId} {
      allow read: if true;
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.body is string
                    && request.resource.data.body.size() >= 2
                    && request.resource.data.body.size() <= 2000;
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'voters'])
                            && (!(request.auth.uid in resource.data.get('voters', [])))
                            && request.resource.data.upvotes == resource.data.get('upvotes', 0) + 1
                            && request.resource.data.voters.size() == resource.data.get('voters', []).size() + 1
                            && request.auth.uid in request.resource.data.voters)
                        || isAdmin());
      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || isAdmin());
    }

    // =============================================
    // PRESENCE (online users)
    // =============================================
    match /presence/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId;
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // =============================================
    // GLOBAL CHAT META (DJ state, etc.)
    // DJ doc structure: { active, djUid, djName, trackTitle, trackArtist, trackCoverArt,
    //   trackId, artistUid, songCount, startedAt, lastHeartbeat, lastTrackChange, trackUrl }
    // =============================================
    // Typing indicators doc: any signed-in user (including anonymous) can read/write
    match /global_chat_meta/typing {
      allow read: if true;
      // F-005: restrict to expected shape only — prevents arbitrary data/cost inflation
      allow write: if request.auth != null
                   && request.resource.data.keys().hasOnly(['typing'])
                   && request.resource.data.typing is map;
    }

    match /global_chat_meta/pinned {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    match /global_chat_meta/{docId} {
      allow read: if true;

      // Strict: creating the DJ doc requires you to be claiming it for yourself.
      // djUid and djName MUST match the authenticated user.
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.djUid == request.auth.uid
                    && request.resource.data.djName is string
                    && request.resource.data.djName.size() >= 2
                    && request.resource.data.djName.size() <= 40;

      // Strict: updates fall into 3 allowed paths:
      //   1) CURRENT DJ updates their own booth (heartbeat, track change, stop).
      //      Must preserve djUid = their own uid.
      //   2) NEW DJ claims an empty/inactive booth. Must set djUid to their own uid
      //      AND djName to a non-empty string.
      //   3) ADMIN override.
      // This closes the hijack vector where anyone could overwrite djName while active=false.
      allow update: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && (
                      // Path 1: current DJ updating their own booth
                      (resource.data.get('djUid', '') == request.auth.uid
                       && request.resource.data.get('djUid', '') == request.auth.uid)
                      ||
                      // Path 2: claiming an empty/inactive booth OR taking over from Nacho auto-DJ.
                      // Must set djUid to self and provide a valid djName.
                      ((resource.data.get('djUid', '') == ''
                        || resource.data.get('djUid', '') == 'nacho-dj'
                        || resource.data.get('active', false) == false)
                       && request.resource.data.djUid == request.auth.uid
                       && request.resource.data.djName is string
                       && request.resource.data.djName.size() >= 2
                       && request.resource.data.djName.size() <= 40)
                      ||
                      // Path 3: admin
                      isAdmin()
                    );

      // DJ Queue subcollection
      match /dj_queue/{queueId} {
        allow read: if true;
        // Can only add/update YOUR OWN queue entry, and it must carry your uid.
        allow create: if request.auth != null
                      && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                      && request.auth.uid == queueId
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() >= 1
                      && request.resource.data.name.size() <= 40;
        allow update: if request.auth != null
                      && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                      && request.auth.uid == queueId
                      && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null
                      && (request.auth.uid == queueId
                          || isAdmin());
      }
    }

    // =============================================
    // ANNOUNCEMENTS (Nacho news feed — separate from global chat)
    // =============================================
    match /announcements/{msgId} {
      allow read: if true;
      // [BUG-6 FIX] Client writes to announcements are permanently disabled.
      // Any authenticated user (including anonymous) could set isNachoAuto=true
      // and inject fake "official Nacho" announcements with arbitrary markdown links.
      // All announcements must now go through the nachoAnnounce Cloud Function
      // (Admin SDK write, non-anonymous auth required, link allowlist enforced).
      allow create: if false;
      // Any signed-in user can toggle their own emoji reaction (only their own uid key within reactions)
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                    && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]);
      // Admin-only delete and full update
      allow delete: if request.auth != null
                    && isAdmin();
    }

    // =============================================
    // GLOBAL CHAT
    // =============================================
    match /global_chat/{msgId} {
      allow read: if true;
      allow create: if (
                    // Authenticated non-anonymous user messages only
                    request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    // Field allowlist: no arbitrary keys that could carry attacker payload
                    && request.resource.data.keys().hasOnly(['uid','name','text','ts','isNachoAuto','faction',
                        'replyTo','replyToName','replyToText',
                        'hasChatFlair','chatFlairEmoji','hasNachoSkin',
                        'isGif','caption','imageUrl','gifUrl'])
                    // F-004: imageUrl/gifUrl must come from Firebase Storage or Tenor CDN only
                    && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl.matches('^https://(firebasestorage[.]googleapis[.]com|[^/]+[.]firebasestorage[.]app|media[.]tenor[.]com|c[.]tenor[.]com)/.*'))
                    && (!('gifUrl'   in request.resource.data) || request.resource.data.gifUrl.matches('^https://(firebasestorage[.]googleapis[.]com|[^/]+[.]firebasestorage[.]app|media[.]tenor[.]com|c[.]tenor[.]com)/.*'))
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && (request.resource.data.text.size() <= 300
                        || (request.resource.data.get('isGif', false) == true
                            && request.resource.data.text.size() <= 500
                            && request.resource.data.text.matches('^https://.*'))
                        || (request.resource.data.uid == 'nacho-bot'
                            && request.resource.data.text.size() <= 2000)
                        || (request.resource.data.get('isNachoAuto', false) == true
                            && request.resource.data.text.size() <= 2000))
                    && request.resource.data.name is string
                    && request.resource.data.ts == request.time
                    // Reply fields: length-cap so they can't carry large payloads
                    && (!('replyToName' in request.resource.data) || (request.resource.data.replyToName is string && request.resource.data.replyToName.size() <= 60))
                    && (!('replyToText' in request.resource.data) || (request.resource.data.replyToText is string && request.resource.data.replyToText.size() <= 300))
                    && (!('replyTo' in request.resource.data) || (
                        request.resource.data.replyTo is string
                        && request.resource.data.replyTo.size() >= 8
                        && request.resource.data.replyTo.size() <= 128
                        && request.resource.data.replyTo.matches('^[A-Za-z0-9_-]+$')
                        && request.resource.data.replyTo != msgId
                    ))
                    && (request.resource.data.uid == request.auth.uid
                        || ((request.resource.data.uid == 'nacho-bot' || request.resource.data.uid == 'system')
                            && isAdmin()))
                    ) || (
                    // Telegram bridge messages — admin/service account only
                    request.auth != null
                    && request.resource.data.source == 'telegram'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.name is string
                    && request.resource.data.uid is string
                    && isAdmin()
                    );
      // Allow reactions update by any authenticated user (must be a map)
      // Allow own message edit: only text/editCount/edited fields, max 2 edits, own message only
      allow update: if request.auth != null
                    && (
                      // Reactions: emoji-keyed map { emoji: [uid,...] }
                      // We can only validate shape here; client enforces per-user logic.
                      // Max 20 distinct emoji reactions to prevent runaway writes.
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                       && request.resource.data.reactions is map
                       && request.resource.data.reactions.size() <= 20
                       && !request.auth.token.firebase.sign_in_provider.matches('anonymous'))
                      ||
                      // Message edit: own message, text only, max 2 edits
                      (resource.data.uid == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editCount','edited'])
                       && request.resource.data.text is string
                       && request.resource.data.text.size() >= 1
                       && request.resource.data.text.size() <= 300
                       && resource.data.get('editCount', 0) < 2)
                    );
      // Own messages or admin can delete
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || isAdmin());
    }

    // =============================================
    // DEFAULT: deny everything else
    // =============================================
    // NOTIFICATIONS
    // =============================================
    match /notifications/{notifId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.recipientId;
      // Display-only. Clients may create social notices (mention, tip, DM).
      // Reward, badge, rank, quest, and streak notices are Cloud Function writes
      // and never pass through this create rule.
      // targetType is a fixed list. targetId, giftId, fromUid, and the doc id
      // must match ^[A-Za-z0-9_-]{1,64}$. senderId must be the signed-in user.
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && notifIdOk(notifId)
                    && request.resource.data.keys().hasOnly(['recipientId', 'senderId', 'senderName', 'type', 'message', 'targetType', 'targetId', 'giftId', 'fromUid', 'read', 'createdAt'])
                    && notifIdOk(request.resource.data.recipientId)
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.senderName is string
                    && request.resource.data.senderName.size() > 0
                    && request.resource.data.senderName.size() <= 40
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 200
                    && request.resource.data.type in ['dm', 'like', 'tip', 'mention', 'reply', 'forum', 'beats_track', 'pvp', 'buddy', 'comment', 'upvote', 'security', 'chat_mention', 'article', 'forum_post']
                    && (request.resource.data.targetType == null
                        || request.resource.data.targetType in ['dm', 'forum_post', 'article', 'beats_track', 'marketplace', 'song', 'chat', 'pvp', 'buddy'])
                    && (request.resource.data.targetId == null
                        || notifIdOk(request.resource.data.targetId))
                    && (!('giftId' in request.resource.data)
                        || request.resource.data.giftId == null
                        || notifIdOk(request.resource.data.giftId))
                    && (!('fromUid' in request.resource.data)
                        || notifIdOk(request.resource.data.fromUid))
                    && request.resource.data.read == false
                    && (!('createdAt' in request.resource.data)
                        || request.resource.data.createdAt == request.time)
                    && !request.resource.data.keys().hasAny(['xp', 'tickets', 'sats', 'points', 'orangeTickets', 'badgeId', 'freezes']);
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.recipientId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read is bool;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.recipientId;
    }

    // =============================================
    // Polls (Sats vs Bits — anonymous voting allowed)
    match /polls/{pollId} {
      allow read: if true;
      // Writes handled server-side via pollVote Cloud Function
      allow write: if false;
    }

    // Certificates (public read, Cloud Function writes only via Admin SDK)
    match /certs/{certId} {
      allow read: if true;
      allow write: if false;
    }

    // Buddy matching pool
    // [AUDIT FIX L-NEW-6] Enforce 1 entry per user via document ID
    match /buddy_pool/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && docId == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && (docId == request.auth.uid || resource.data.uid == request.auth.uid || isAdmin());
    }

    // Faucet invoice dedup (Cloud Function only)
    match /faucet_invoices/{docId} {
      allow read, write: if false; // Cloud Function admin SDK only
    }

    // Faucet stats (Cloud Function only, admin can read)
    match /faucet_stats/{docId} {
      allow read: if request.auth != null
                  && isAdmin();
      allow write: if false;
    }

    // Faucet config (Cloud Function only, admin can read)
    match /faucet_config/{docId} {
      allow read: if request.auth != null
                  && isAdmin();
      allow write: if false;
    }

    // Faucet IP log (Cloud Function only)
    match /faucet_ip_log/{docId} {
      allow read, write: if false;
    }

    // Faucet fingerprints (Cloud Function only)
    match /faucet_fingerprints/{docId} {
      allow read, write: if false;
    }

    // Faucet lifetime ledger — server-only, immune to client account deletion.
    // Tracks satsWithdrawn + lastSatsClaim keyed by UID. Even if the user deletes
    // their /users/{uid} doc, this ledger persists (Fix C-NEW-6).
    match /faucet_ledger/{docId} {
      allow read, write: if false; // Cloud Function admin SDK only
    }

    // Server-side daily points tracking (Cloud Function only)
    match /users/{userId}/daily_points/{docId} {
      allow read, write: if false;
    }

    // Onboarding evidence (Nacho asked, copied quiz proof). Cloud Function only.
    match /users/{userId}/onboarding_evidence/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Server-side per-day action count tracking (Cloud Function only)
    // Used to enforce hard daily limits on spam-prone actions (e.g. beats_upload=5/day)
    match /users/{userId}/daily_action_counts/{docId} {
      // Owner can read their own flex/action records (needed for client-side FLEX restore)
      // Say-hi claims live here as {serverDay}_say_hi. Clients cannot write them.
      allow read: if request.auth != null && request.auth.uid == userId;
      // Writes only from Cloud Functions (server-side enforcement)
      allow write: if false;
    }

    // Quiz part completions. Cloud Functions only — not the client-editable
    // completedQuests array on the user doc.
    match /users/{userId}/quest_completions/{docId} {
      allow read, write: if false;
    }

    // One pass per quiz part. gradeQuest writes this so questsPassed cannot be farmed.
    match /users/{userId}/quest_passes/{docId} {
      allow read, write: if false;
    }

    // Server-side badge award deduplication (Cloud Function only)
    match /users/{userId}/badge_awards/{docId} {
      allow read, write: if false;
    }

    // Topic conversation XP ledger. Written only by the server function that
    // accepts the post. source is topic_conversation. Clients cannot write it.
    match /users/{userId}/xp_ledger/{docId} {
      allow read, write: if false;
    }

    // One certification completion bonus per cert type. gradeScholarExam
    // writes prop or tech. Clients cannot create or edit the marker.
    match /users/{userId}/cert_bonuses/{docId} {
      allow read, write: if false;
    }

    // Action cooldown tracking (Cloud Function only)
    match /action_cooldowns/{docId} {
      allow read, write: if false;
    }

    // Buddy matches
    // [AUDIT FIX L-NEW-10] Prevent fake matches via deterministic ID and ownership
    match /buddy_matches/{docId} {
      allow read: if request.auth != null
                  && (resource.data.user1.uid == request.auth.uid
                      || resource.data.user2.uid == request.auth.uid);
      
      // Prevent arbitrary match creation — enforce deterministic UID-based document ID
      allow create: if request.auth != null
                    && (request.resource.data.user1.uid == request.auth.uid || request.resource.data.user2.uid == request.auth.uid)
                    && (request.resource.data.user1.uid < request.resource.data.user2.uid ? 
                        docId == request.resource.data.user1.uid + '_' + request.resource.data.user2.uid : 
                        docId == request.resource.data.user2.uid + '_' + request.resource.data.user1.uid);
      
      allow delete: if request.auth != null
                    && (resource.data.user1.uid == request.auth.uid
                        || resource.data.user2.uid == request.auth.uid);
    }

    // Timechain TV viewer counts — increment/decrement by 1 only
    match /timechain_viewers/{stationId} {
      allow read: if true;
      allow write: if false; // deprecated — use tctv_presence
    }

    // UTC calendar day as YYYYMMDD. Timestamp parts are UTC.
    function tctvUtcDay() {
      return string(request.time.year())
        + (request.time.month() < 10 ? '0' : '') + string(request.time.month())
        + (request.time.day() < 10 ? '0' : '') + string(request.time.day());
    }

    function tctvStationOk(id) {
      return id is string && id.matches('^(pleb-underground|ai-nostr|art-philosophy|orange-pill|conferences-events|culture-travel|dev-privacy-nodes|economics-money|freedom-sovereignty|health-fitness|history|kids-family|lightning|memes-comedy|mining|music|news|podcasts-debates|politics-regulation|saylor|future-predictions|tutorials)$');
    }

    // TCTV public stats — 'views' (cumulative tune-ins) + 'peak' (all-time concurrent).
    // Clients may read. Only tctvAggregatePresence (Admin SDK) writes them.
    // view_cursor is the fold watermark for tctv_view_days and is server-only too.
    match /tctv_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /tctv_presence/{viewerId} {
      // Clients render the counter from tctv_counts/live. Listing this
      // collection is what used to read every stale presence doc, so list
      // stays closed. A single-doc get is still allowed.
      allow get: if true;
      allow list: if false;
      // Signed-in viewers must write viewerId == request.auth.uid.
      // Logged-out viewers use a v_ id from localStorage, and only when
      // the request itself is unauthenticated.
      // ts must be the server timestamp so a client cannot pin itself fresh.
      // expiresAt is optional so pages still on the previous script keep
      // working. The new script always sends it (~10 min ahead) for the
      // TTL policy on tctv_presence.expiresAt. The window is wide on
      // purpose: a skewed clock can still write, and a client still cannot
      // push expiry out by days. The minute job deletes by ts, not expiresAt.
      allow create, update: if
        (
          (request.auth != null && viewerId == request.auth.uid)
          || (request.auth == null && viewerId.matches('^v_[a-z0-9]{5,40}$'))
        )
        && request.resource.data.keys().hasOnly(['station', 'ts', 'tsClient', 'expiresAt'])
        && request.resource.data.station is string
        && request.resource.data.station.size() > 0
        && request.resource.data.station.size() < 50
        && request.resource.data.ts == request.time
        && (
          !('expiresAt' in request.resource.data)
          || (
            request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time - duration.value(12, 'h')
            && request.resource.data.expiresAt < request.time + duration.value(2, 'h')
          )
        )
        && (!('tsClient' in request.resource.data) || request.resource.data.tsClient is number);
      // Auth-uid docs: only the owning user can delete.
      // v_ anon docs: open delete (worst case: griefer evicts strangers; they'll auto-re-register in <30s).
      allow delete: if
        (request.auth != null && viewerId == request.auth.uid)
        || viewerId.matches('^v_[a-z0-9]{5,40}$');
    }

    // One aggregate doc for the live viewer counter. Written only by
    // tctvAggregatePresence. Clients listen to this doc instead of scanning presence.
    match /tctv_counts/{docId} {
      allow get: if docId == 'live';
      allow list: if false;
      allow write: if false;
    }

    // One manual tune per viewer, channel, and UTC day.
    // Doc id is day_viewerId_station. Create only; the minute job increments
    // tctv_stats/views from these docs. Clients cannot update or delete, so
    // they cannot clear `counted` or move `ts` to be counted again.
    // Block-surf does not write here. Presence rules are unchanged.
    match /tctv_view_days/{docId} {
      allow get, list: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['viewerId', 'station', 'day', 'ts'])
        && request.resource.data.day == tctvUtcDay()
        && request.resource.data.day is string
        && request.resource.data.ts == request.time
        && tctvStationOk(request.resource.data.station)
        && request.resource.data.viewerId is string
        && docId == request.resource.data.day + '_' + request.resource.data.viewerId + '_' + request.resource.data.station
        && (
          (request.auth != null
            && request.resource.data.viewerId == request.auth.uid
            && docId.matches('^[0-9]{8}_[A-Za-z0-9_-]{1,128}_[a-z0-9-]{1,48}$'))
          || (request.auth == null
            && request.resource.data.viewerId.matches('^v_[a-z0-9]{5,40}$')
            && docId.matches('^[0-9]{8}_v_[a-z0-9]{5,40}_[a-z0-9-]{1,48}$'))
        );
      allow update, delete: if false;
    }

    // AI Tools open tracking — anyone can create, no reads/updates/deletes
    match /ai_tools_opens/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(['uid', 'openedAt'])
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() < 60;
      allow read, update, delete: if false;
    }

    // Poll Quest votes — anyone can read, signed-in users can write
    // Poll Quest votes. The tally is written by dailyPollVote. Clients can read it.
    match /poll_votes/{pollId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /poll_cumulative/{pollId} {
      allow read: if true;
      allow create: if request.auth != null
                    && pollId.matches('^[a-zA-Z0-9_-]{1,80}$')
                    && request.resource.data.keys().hasOnly(['total', 'option_0', 'option_1', 'option_2', 'option_3', 'pollId', 'question']);
      // [SECURITY FIX] create: values must be 0 or 1; total must equal 1 (first vote).
      // Previously unconstrained — any value could be set on create.
      allow create: if request.auth != null
                    && pollId.matches('^[a-zA-Z0-9_-]{1,80}$')
                    && request.resource.data.keys().hasOnly(['total', 'option_0', 'option_1', 'option_2', 'option_3', 'pollId', 'question'])
                    && request.resource.data.total == 1
                    && request.resource.data.get('option_0', 0) >= 0 && request.resource.data.get('option_0', 0) <= 1
                    && request.resource.data.get('option_1', 0) >= 0 && request.resource.data.get('option_1', 0) <= 1
                    && request.resource.data.get('option_2', 0) >= 0 && request.resource.data.get('option_2', 0) <= 1
                    && request.resource.data.get('option_3', 0) >= 0 && request.resource.data.get('option_3', 0) <= 1;
      // All numeric fields are monotonically increasing AND bounded to +1 per update.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['total', 'option_0', 'option_1', 'option_2', 'option_3', 'pollId', 'question'])
                    // total: monotone increasing, at most +1
                    && request.resource.data.total >= resource.data.get('total', 0)
                    && request.resource.data.total <= resource.data.get('total', 0) + 1
                    // each option: monotone increasing, at most +1
                    && request.resource.data.get('option_0', 0) >= resource.data.get('option_0', 0)
                    && request.resource.data.get('option_0', 0) <= resource.data.get('option_0', 0) + 1
                    && request.resource.data.get('option_1', 0) >= resource.data.get('option_1', 0)
                    && request.resource.data.get('option_1', 0) <= resource.data.get('option_1', 0) + 1
                    && request.resource.data.get('option_2', 0) >= resource.data.get('option_2', 0)
                    && request.resource.data.get('option_2', 0) <= resource.data.get('option_2', 0) + 1
                    && request.resource.data.get('option_3', 0) >= resource.data.get('option_3', 0)
                    && request.resource.data.get('option_3', 0) <= resource.data.get('option_3', 0) + 1;
    }

    // Trivia cumulative stats (all-time per question) — read public, increment only
    match /trivia_cumulative/{triviaId} {
      allow read: if true;
      // [SECURITY FIX] create: schema locked + values bounded (was completely unconstrained)
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['total', 'option_0', 'option_1', 'option_2', 'option_3', 'triviaIndex'])
                    && request.resource.data.total == 1
                    && request.resource.data.get('option_0', 0) >= 0 && request.resource.data.get('option_0', 0) <= 1
                    && request.resource.data.get('option_1', 0) >= 0 && request.resource.data.get('option_1', 0) <= 1
                    && request.resource.data.get('option_2', 0) >= 0 && request.resource.data.get('option_2', 0) <= 1
                    && request.resource.data.get('option_3', 0) >= 0 && request.resource.data.get('option_3', 0) <= 1;
      // [SECURITY FIX] update: monotone increasing AND at most +1 per field per update
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['total', 'option_0', 'option_1', 'option_2', 'option_3', 'triviaIndex'])
                    && request.resource.data.total >= resource.data.get('total', 0)
                    && request.resource.data.total <= resource.data.get('total', 0) + 1
                    && request.resource.data.get('option_0', 0) >= resource.data.get('option_0', 0)
                    && request.resource.data.get('option_0', 0) <= resource.data.get('option_0', 0) + 1
                    && request.resource.data.get('option_1', 0) >= resource.data.get('option_1', 0)
                    && request.resource.data.get('option_1', 0) <= resource.data.get('option_1', 0) + 1
                    && request.resource.data.get('option_2', 0) >= resource.data.get('option_2', 0)
                    && request.resource.data.get('option_2', 0) <= resource.data.get('option_2', 0) + 1
                    && request.resource.data.get('option_3', 0) >= resource.data.get('option_3', 0)
                    && request.resource.data.get('option_3', 0) <= resource.data.get('option_3', 0) + 1;
    }

    // ===== RAID BOSS =====
    // Per-user daily contribution caps — Cloud Function writes only
    match /raid_daily_caps/{docId} {
      allow read, write: if false; // Admin SDK bypasses rules
    }

    // Boss documents — read-only for all, server (admin SDK) writes
    match /raid_bosses/{bossId} {
      allow read: if true;
      allow create, update, delete: if false; // Admin SDK bypasses rules

      // Participants — read-only for all, server writes
      match /participants/{uid} {
        allow read: if true;
        allow write: if false; // Admin SDK bypasses rules
      }

      // Winners — read-only for all
      match /winners/{winnerId} {
        allow read: if true;
        allow write: if false; // Admin SDK bypasses rules
      }
    }

    // ===== SATOSHI'S FAVOR =====
    // Main state document — public read, server writes
    match /satoshiFavor/current {
      allow read: if true;
      allow write: if false; // Cloud Functions only

      // Contributors — owner may read their own docs. No client writes.
      // A list of someone else's docs fails because the query cannot match uid.
      match /contributors/{docId} {
        allow read: if request.auth != null
          && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      // Hashes subcollection — public read, Cloud Functions only write
      match /hashes/{hashId} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      // Cooldowns subcollection — server writes only
      match /cooldowns/{uid} {
        allow read, write: if false; // Admin SDK bypasses rules
      }

      // Session hashes — live leaderboard for current mining window
      // Public read so anyone can watch the leaderboard; server writes only
      match /session_hashes/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Faction totals — public read, server writes only
    // Announce dedup doc — clients race to claim start/end announce slots (prevents spam)
    match /satoshiFavor/announceDedup {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['startAnnouncedAt', 'endAnnouncedAt']);
    }

    match /satoshiFavor/factionTotals {
      allow read: if true;
      allow write: if false;
    }

    // Per-user all-time Satoshi's Favor contribution. Server writes only.
    // The owner can read their own total. Other clients cannot.
    match /satoshiFavor/userSfPoints {
      allow read, write: if false;
      match /users/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Faction sync records — server writes only
    match /satoshiFavor/factionSyncs {
      allow read: if false;
      allow write: if false;
      match /users/{uid} {
        allow read: if false;
        allow write: if false;
      }
    }

    // Top hashes leaderboard — public read, server writes
    match /satoshiFavor/topHashes {
      allow read: if true;
      allow write: if false;
    }

    // Difficulty stats — cumulative hash counts per difficulty target, public read
    match /satoshiFavor/difficultyStats {
      allow read: if true;
      allow write: if false;
    }

    // Last window archive — public read, server writes only
    match /satoshiFavor/lastWindow {
      allow read: if true;
      allow write: if false;
    }

    // Pool epoch tracker — public read, server writes only
    match /satoshiFavor/poolEpoch {
      allow read: if true;
      allow write: if false;
    }

    // SF Pool history — completed epochs, public read, server writes only
    match /sfPoolHistory/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Personal bests — public read, server writes
    // Personal bests — legacy parent doc (read-only, server writes)
    match /satoshiFavor/personalBests {
      allow read: if true;
      allow write: if false;

      // Per-user personal best docs — user can only read their own
      match /users/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Trivia answer stats — public read, authenticated users can merge-increment
    match /trivia_stats/{date} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['total', 'option_0', 'option_1', 'option_2', 'option_3'])
                   && request.resource.data.total == 1;
      // [SECURITY FIX] update: monotone increasing AND at most +1 per field per update
      allow update: if request.auth != null
                   && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['total', 'option_0', 'option_1', 'option_2', 'option_3'])
                   && request.resource.data.total >= resource.data.get('total', 0)
                   && request.resource.data.total <= resource.data.get('total', 0) + 1
                   && request.resource.data.get('option_0', 0) >= resource.data.get('option_0', 0)
                   && request.resource.data.get('option_0', 0) <= resource.data.get('option_0', 0) + 1
                   && request.resource.data.get('option_1', 0) >= resource.data.get('option_1', 0)
                   && request.resource.data.get('option_1', 0) <= resource.data.get('option_1', 0) + 1
                   && request.resource.data.get('option_2', 0) >= resource.data.get('option_2', 0)
                   && request.resource.data.get('option_2', 0) <= resource.data.get('option_2', 0) + 1
                   && request.resource.data.get('option_3', 0) >= resource.data.get('option_3', 0)
                   && request.resource.data.get('option_3', 0) <= resource.data.get('option_3', 0) + 1;
    }

    // Charity donations — public read (for leaderboard/feed), CF-only write
    match /charity_donations/{donationId} {
      allow read: if true;
      allow write: if false;
    }

    // Charity global stats — public read, CF-only write
    match /charity_stats/{statId} {
      allow read: if true;
      allow write: if false;
    }

    // Weekly challenges — public read, CF-only write (except increment via CF)
    match /weekly_challenges/{weekKey} {
      allow read: if true;
      allow write: if false; // All writes via Cloud Functions
    }

    // Leaderboard winners history — public read, CF-only write
    match /leaderboard_winners/{period} {
      allow read: if true;
      allow write: if false;
    }

    // Hot Topics — public read, Cloud Function write only
    match /hotTopics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // CSRF nonce store for Strava OAuth — server-side only, clients have zero access
    match /strava_nonces/{nonce} {
      allow read, write: if false;
    }

    // =============================================
    // GIFTS — peer-to-peer gifting system
    // ticketCount lives in gift_secrets (CF-only), never in the gifts doc
    // =============================================
    match /gifts/{giftId} {
      // Current owner (holding it or received it) and original sender can read
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.sentBy == request.auth.uid);
      allow write: if false; // Cloud Function (Admin SDK) only
    }

    // Gift ticket secrets — never readable by clients, CF Admin SDK only
    match /gift_secrets/{giftId} {
      allow read, write: if false;
    }

    // One-pending-per-pair tracker — CF (Admin SDK) only
    // docId = {senderUid}_{recipientUid}; set on send, deleted on open
    match /gift_pending_pairs/{pairId} {
      allow read, write: if false;
    }

    // Keys — owner (and the person who sent it) may read. Writes are Cloud Functions only.
    // Inventory keys and sent keys are the same collection. `sender` is set
    // only by sendKeys. A key the user earns has no sender. Clients cannot
    // create or update that field, because every write is denied.
    match /keys/{keyId} {
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.sentBy == request.auth.uid
                      || resource.data.sender == request.auth.uid);
      allow write: if false;
    }

    // Locked ciphers — only the owner may read. Writes are Cloud Functions only.
    match /locked_ciphers/{cipherId} {
      allow read: if request.auth != null
                  && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // One send per sender+recipient per day. Sender may read their own pair docs.
    match /key_send_pairs/{pairId} {
      allow read: if request.auth != null
                  && resource.data.senderUid == request.auth.uid;
      allow write: if false;
    }

    // Sats-win ledger. Server-only and append-only from the client's point of view.
    // Admins read it through adminListCipherWins; winners claim through claimCipherWin.
    match /cipher_wins/{winId} {
      allow read, write: if false;
    }

    // One shared-prize marker per cipher open. Admin SDK only, so a client
    // cannot mark a share paid or revealed, and cannot invent a sender.
    match /cipher_shares/{shareId} {
      allow read, write: if false;
    }

    // =============================================
    // PEER REQUESTS
    // All writes go through the managePeer Cloud Function (Admin SDK).
    // Participants may read their own requests only (sent or received).
    // =============================================
    match /peer_requests/{reqId} {
      allow read: if request.auth != null
                  && (resource.data.from == request.auth.uid
                      || resource.data.to == request.auth.uid);
      allow write: if false; // Cloud Function (Admin SDK) only
    }

    // =============================================
    // PEER RELATIONSHIPS — partnership levels
    // Written exclusively by updatePeerLevelAfterGift (Admin SDK).
    // Clients may only read their own pair docs (uid1 or uid2 match).
    // No client writes — ever. XP, level, giftsExchanged are all CF-owned.
    // =============================================
    match /peerRelationships/{pairId} {
      // Only participants of this pair can read it
      allow read: if request.auth != null
                  && (resource.data.uid1 == request.auth.uid
                      || resource.data.uid2 == request.auth.uid);
      allow write: if false; // Cloud Function (Admin SDK) only
    }

    // =============================================
    // ADMIN AUDIT LOG — server-write only, no client access
    // =============================================
    match /admin_audit_log/{logId} {
      allow read, write: if false; // Cloud Function (Admin SDK) only
    }

    // One-time withdrawal-address reset. Server only, including the marker.
    match /ln_resets/{uid} {
      allow read, write: if false;
    }

    // One Lightning address, owned by one uid. Clients may read their own lock.
    match /lightning_addresses/{addrId} {
      allow get: if request.auth != null
                 && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    // Faucet subnet and per-uid claim signals. Server only.
    match /faucet_subnet_log/{docId} {
      allow read, write: if false;
    }
    match /faucet_uid_signals/{docId} {
      allow read, write: if false;
    }
    match /faucet_ln_ratelimit/{docId} {
      allow read, write: if false;
    }

    // Daily faucet abuse report and the flags that feed it. Admins read, server writes.
    match /faucet_admin_flags/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /faucet_abuse_reports/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reply-bonus callable state. Admin SDK only. Clients cannot read or
    // write the first-reward flag, the per-message claim, or the pair window.
    match /reply_bonus_state/{docId} {
      allow read, write: if false;
    }
    match /reply_bonus_claims/{docId} {
      allow read, write: if false;
    }
    match /reply_bonus_pairs/{docId} {
      allow read, write: if false;
    }

    // Callable rate limits (say-hi and reply_{uid}). Admin SDK only.
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // Daily HMAC salt for network rate limits. Admin SDK only.
    match /rate_limit_salts/{docId} {
      allow read, write: if false;
    }

    // Nacho activity shoutouts. Claims and rate limits are server-only so a
    // client cannot forge a Nacho post or reset the cap.
    // One marker per listing so onMarketplaceListingCount cannot double-count.
    match /market_listing_counts/{listingId} {
      allow read, write: if false;
    }

    match /market_listing_daily/{docId} {
      allow read, write: if false;
    }
    match /market_message_counts/{docId} {
      allow read, write: if false;
    }
    match /market_sale_counts/{docId} {
      allow read, write: if false;
    }
    match /polls/{dayId}/votes/{voteUid} {
      allow read, write: if false;
    }

    match /shoutout_claims/{claimId} {
      allow read, write: if false;
    }
    match /shoutout_limits/{limitId} {
      allow read, write: if false;
    }

    // Daily Timechain TV watch ledger. The owner may read progress for the
    // home button. Watch time, the daily claim, XP, and orange tickets are
    // written only by tctvWatchHeartbeat (Admin SDK). Clients cannot write.
    match /tctv_watch/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Live topic comments. Public read so guests can follow a thread.
    // Every create, hide, delete, and report goes through a callable.
    match /topic_discussions/{channelId} {
      allow read: if true;
      allow write: if false;
      match /posts/{postId} {
        allow read: if true;
        allow write: if false;
        match /reports/{reportId} {
          allow read, write: if false;
        }
      }
    }
    match /topic_discussion_limits/{docId} {
      allow read, write: if false;
    }
    match /topic_discussion_caps/{docId} {
      allow read, write: if false;
    }
    match /topic_discussion_private/{docId} {
      allow read, write: if false;
    }
    match /key_gift_credits/{docId} {
      allow read, write: if false;
    }
    match /peer_key_days/{docId} {
      allow read, write: if false;
    }
    match /key_use_credits/{docId} {
      allow read, write: if false;
    }
    match /peer_xp_credits/{docId} {
      allow read, write: if false;
    }
    match /topic_comment_pending/{docId} {
      allow read, write: if false;
    }
    match /deleted_accounts/{docId} {
      allow read, write: if false;
    }
    match /email_history/{docId} {
      allow read, write: if false;
    }
    match /email_change_pending/{docId} {
      allow read, write: if false;
    }
    match /identity_history/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
