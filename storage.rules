rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // V4V imported audio (read-only public, write via Admin SDK only)
    match /beats-v4v/{feedSlug}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    // V4V imported cover art
    match /beats-v4v-covers/{feedSlug}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Beats audio files
    match /beats/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }
    // Beats cover art
    match /beats-covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // Article images (inline images from toolbar)
    match /article-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // Article cover images
    match /articles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // IRL event photos
    match /irl-events/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // Global chat image uploads (own folder, size+type enforced)
    match /chat-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // DM image uploads (private messages)
    // Read: owner always; anyone else must have an existing DM conversation with the uploader.
    // Conversation ID is deterministic: smaller_uid + '_' + larger_uid (mirrors getConversationId() in JS).
    // This prevents a leaked URL from being loaded by arbitrary authenticated users.
    match /dm-images/{uploaderId}/{fileName} {
      allow read: if request.auth != null
                  && (request.auth.uid == uploaderId
                      || firestore.exists(
                           /databases/(default)/documents/dm_conversations/$(
                             uploaderId < request.auth.uid
                               ? uploaderId + '_' + request.auth.uid
                               : request.auth.uid + '_' + uploaderId
                           )
                         ));
      allow write: if request.auth != null
                   && request.auth.uid == uploaderId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // Default: deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
