rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // V4V imported audio (read-only public, write via Admin SDK only)
    match /beats-v4v/{feedSlug}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    // V4V imported cover art
    match /beats-v4v-covers/{feedSlug}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Beats audio files
    match /beats/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }
    // Beats cover art
    match /beats-covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // Article images (inline images from toolbar)
    match /article-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // Article cover images
    match /articles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // IRL event photos
    match /irl-events/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // Global chat image uploads (own folder, size+type enforced)
    match /chat-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }
    // DM image uploads (private messages). F-004.
    // A DM image is readable only by the people in that conversation.
    //
    // Legacy layout (every image uploaded so far, and the current client):
    //   dm-images/{uploaderId}/{fileName}
    // The path does not say which conversation the image belongs to, so the
    // rules cannot tell which partner it was sent to. Only the uploader may
    // read, list, write or delete here. Recipients keep seeing images through
    // the tokenized download URL stored in the DM message, which only the
    // conversation's participants can read in Firestore. Download URLs do not
    // go through these rules, so existing DMs keep loading.
    match /dm-images/{uploaderId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == uploaderId;
      allow create, update: if request.auth != null
                   && request.auth.uid == uploaderId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
      allow delete: if request.auth != null
                    && request.auth.uid == uploaderId;
    }

    // Conversation-scoped layout (for a later client change):
    //   dm-images/{uploaderId}/{convoId}/{fileName}
    // Read: both participants of dm_conversations/{convoId}, and only when the
    // uploader is also in that conversation. Write: the uploader, who must be a
    // participant. The conversation doc must exist first.
    function dmParticipants(convoId) {
      return firestore.get(/databases/(default)/documents/dm_conversations/$(convoId)).data.participants;
    }
    // The id must also be the sorted uid pair, so an old conversation doc made
    // under some other id (before the Firestore create check) never counts.
    function inDm(convoId, uid) {
      return firestore.exists(/databases/(default)/documents/dm_conversations/$(convoId))
          && dmParticipants(convoId).size() == 2
          && uid in dmParticipants(convoId)
          && convoId == (dmParticipants(convoId)[0] < dmParticipants(convoId)[1]
                          ? dmParticipants(convoId)[0] + '_' + dmParticipants(convoId)[1]
                          : dmParticipants(convoId)[1] + '_' + dmParticipants(convoId)[0]);
    }
    match /dm-images/{uploaderId}/{convoId}/{fileName} {
      allow read: if request.auth != null
                  && inDm(convoId, request.auth.uid)
                  && inDm(convoId, uploaderId);
      allow create, update: if request.auth != null
                   && request.auth.uid == uploaderId
                   && inDm(convoId, request.auth.uid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
      allow delete: if request.auth != null
                    && request.auth.uid == uploaderId;
    }
    // Default: deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
