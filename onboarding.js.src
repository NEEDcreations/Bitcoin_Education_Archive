// Welcome tour + first quest. Rewards are claimed from claimOnboardingQuestStep.
(function () {
    'use strict';

    var INTRO_KEY = 'btc_intro_seen';
    var QUEST_DONE = 'btc_onboarding_quest_done';
    var QUEST_ACTIVE = 'btc_onboarding_active';
    var QUEST_STEP = 'btc_onboarding_step';
    var PENDING_KEY = 'btc_quest_pending';

    var QUEST_MODES = {
        beginner: ['pick_topic', 'find_nacho', 'first_quiz'],
        intermediate: ['pick_topic', 'find_nacho', 'send_chat', 'first_quiz'],
        advanced: ['pick_topic', 'send_chat', 'spin_wheel', 'find_nacho', 'first_quiz']
    };
    var QUEST_STEPS = {
        pick_topic: { title: 'Open a channel', detail: 'Tap any topic and start reading.', signal: 'channel', beacon: '#channelList' },
        send_chat: { title: 'Say hello in chat', detail: 'Send a message in Global Chat.', signal: 'chat', beacon: '#chatOverlayBtn' },
        spin_wheel: { title: 'Take the daily spin', detail: 'Open the daily spin and spin once.', signal: 'spin', beacon: '#nqSpinBtn' },
        find_nacho: { title: 'Ask Nacho', detail: 'Ask Nacho a Bitcoin question.', signal: 'nacho', beacon: '#nacho-container' },
        first_quiz: { title: 'Try a quiz', detail: 'Finish a quiz, a trivia question, or a poll.', signal: 'quiz', beacon: '#onboardingQuizEntry' }
    };

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
    }

    window.btcClaimSessionPopup = function (kind) {
        try {
            var cur = sessionStorage.getItem('btc_session_popup');
            if (!cur) {
                sessionStorage.setItem('btc_session_popup', kind);
                return true;
            }
            if (cur === kind) return true;
            if (kind === 'onboarding' && localStorage.getItem(INTRO_KEY) !== '1') {
                sessionStorage.setItem('btc_session_popup', 'onboarding');
                return true;
            }
        } catch (e) {}
        return false;
    };
    window.btcPopupBlocked = function (kind) {
        try {
            var cur = sessionStorage.getItem('btc_session_popup');
            if (!cur) return false;
            return cur !== kind;
        } catch (e) { return false; }
    };

    window.getExperienceMode = function () {
        var m = '';
        try { m = localStorage.getItem('btc_experience_mode') || ''; } catch (e) {}
        if (m !== 'beginner' && m !== 'intermediate' && m !== 'advanced') return 'advanced';
        return m;
    };
    window.getUserSimplificationLevel = function () {
        return window.getExperienceMode() === 'advanced' ? 'full' : window.getExperienceMode();
    };
    window.setExperienceMode = function (mode) {
        if (mode !== 'beginner' && mode !== 'intermediate' && mode !== 'advanced') mode = 'advanced';
        try { localStorage.setItem('btc_experience_mode', mode); } catch (e) {}
        try {
            if (typeof auth !== 'undefined' && auth && auth.currentUser && typeof db !== 'undefined' && db) {
                db.collection('users').doc(auth.currentUser.uid).set({ experienceMode: mode }, { merge: true }).catch(function () {});
            }
        } catch (e) {}
        if (typeof window.applySimplifiedHome === 'function') window.applySimplifiedHome();
    };
    window.syncExperienceModeFromFirestore = function () {
        try {
            if (typeof auth === 'undefined' || !auth || !auth.currentUser || typeof db === 'undefined') return;
            db.collection('users').doc(auth.currentUser.uid).get().then(function (doc) {
                if (!doc.exists) return;
                var m = doc.data().experienceMode;
                if (m === 'beginner' || m === 'intermediate' || m === 'advanced') {
                    try { localStorage.setItem('btc_experience_mode', m); } catch (e) {}
                }
                if (doc.data().introSeen === true) {
                    try { localStorage.setItem(INTRO_KEY, '1'); } catch (e) {}
                }
            }).catch(function () {});
        } catch (e) {}
    };
    window.getOnboardingProfile = function () {
        return { level: window.getExperienceMode(), interests: [] };
    };
    window.isOnboardingComplete = function () {
        try { return localStorage.getItem(INTRO_KEY) === '1' || localStorage.getItem('btc_onboarding_done') === 'true'; }
        catch (e) { return false; }
    };

    function questList() {
        return (QUEST_MODES[window.getExperienceMode()] || QUEST_MODES.advanced).slice();
    }
    window.isNachoQuestDone = function () {
        try { return localStorage.getItem(QUEST_DONE) === '1'; } catch (e) { return false; }
    };
    window.isNachoQuestActive = function () {
        try { return localStorage.getItem(QUEST_ACTIVE) === '1' && !window.isNachoQuestDone(); }
        catch (e) { return false; }
    };
    window.getNachoQuestStep = function () {
        var n = 0;
        try { n = parseInt(localStorage.getItem(QUEST_STEP) || '0', 10) || 0; } catch (e) {}
        var list = questList();
        if (n < 0) n = 0;
        if (n >= list.length) n = Math.max(0, list.length - 1);
        return n;
    };
    function currentStepId() {
        var list = questList();
        return list[window.getNachoQuestStep()] || list[0];
    }

    function signedInReal() {
        try {
            return typeof auth !== 'undefined' && auth && auth.currentUser && !auth.currentUser.isAnonymous;
        } catch (e) { return false; }
    }

    function rememberPending(stepId) {
        var list = [];
        try { list = JSON.parse(localStorage.getItem(PENDING_KEY) || '[]'); } catch (e) { list = []; }
        if (!Array.isArray(list)) list = [];
        if (list.indexOf(stepId) === -1) list.push(stepId);
        try { localStorage.setItem(PENDING_KEY, JSON.stringify(list)); } catch (e) {}
    }

    function callFn(name, payload) {
        if (typeof firebase === 'undefined' || !firebase.functions) return Promise.reject(new Error('offline'));
        return firebase.functions().httpsCallable(name)(payload || {});
    }

    window.flushOnboardingClaims = function () {
        if (!signedInReal()) return;
        var list = [];
        try { list = JSON.parse(localStorage.getItem(PENDING_KEY) || '[]'); } catch (e) { list = []; }
        if (!Array.isArray(list) || !list.length) return;
        var next = list.slice();
        function run() {
            if (!next.length) {
                try { localStorage.removeItem(PENDING_KEY); } catch (e) {}
                return;
            }
            var id = next.shift();
            callFn('claimOnboardingQuestStep', { stepId: id }).then(function (res) {
                var data = res && res.data ? res.data : {};
                if (data.ok && !data.already && typeof showToast === 'function') {
                    var bits = [];
                    if (data.awarded) bits.push('+' + data.awarded + ' XP');
                    if (data.tickets) bits.push('+' + data.tickets + ' tickets');
                    if (bits.length) showToast('Quest reward saved: ' + bits.join(', '), 4000);
                }
                if (data.complete) markQuestDone(data);
                else if (!data.ok && data.error === 'not_verified') rememberPending(id);
                run();
            }).catch(function () { rememberPending(id); });
        }
        run();
    };

    function markQuestDone(data) {
        try {
            localStorage.setItem(QUEST_DONE, '1');
            localStorage.removeItem(QUEST_ACTIVE);
        } catch (e) {}
        window._clearNachoQuestBeacon && window._clearNachoQuestBeacon();
        var pill = document.getElementById('nachoQuestPill');
        if (pill) pill.remove();
        var pts = data && data.totalPts ? data.totalPts : 0;
        var tickets = data && data.totalTickets ? data.totalTickets : 0;
        if (typeof showToast === 'function') {
            showToast('First quest complete' + (pts ? ' · ' + pts + ' XP' : '') + (tickets ? ' · ' + tickets + ' tickets' : ''), 5000);
        }
    }

    function advanceLocal() {
        var list = questList();
        var i = window.getNachoQuestStep() + 1;
        if (i >= list.length) {
            if (signedInReal()) return;
            try { localStorage.setItem(QUEST_STEP, String(list.length)); } catch (e) {}
            if (typeof showToast === 'function') showToast('Quest checklist done. Sign in to collect the rewards.', 5000);
            return;
        }
        try { localStorage.setItem(QUEST_STEP, String(i)); } catch (e) {}
        window._showNachoQuestPill();
        window._nachoQuestBeaconForStep(i);
    }

    window._completeNachoQuestStep = function (stepId) {
        if (!QUEST_STEPS[stepId] || window.isNachoQuestDone()) return;
        if (!signedInReal()) {
            rememberPending(stepId);
            if (typeof showToast === 'function') showToast('Create an account to collect this reward.', 4000);
            advanceLocal();
            return;
        }
        callFn('claimOnboardingQuestStep', { stepId: stepId }).then(function (res) {
            var data = res && res.data ? res.data : {};
            if (data.ok) {
                if (!data.already && typeof showToast === 'function') {
                    var msg = QUEST_STEPS[stepId].title + ' saved';
                    if (data.awarded) msg += ' · +' + data.awarded + ' XP';
                    if (data.tickets) msg += ' · +' + data.tickets + ' tickets';
                    showToast(msg, 4000);
                }
                if (data.complete) { markQuestDone(data); return; }
                advanceLocal();
                return;
            }
            if (data.error === 'not_verified') {
                try {
                    localStorage.removeItem('btc_quest_step_done_' + stepId);
                    localStorage.setItem('btc_quest_wait_' + stepId, String(Date.now() + 20000));
                    if (!localStorage.getItem('btc_quest_hint_' + stepId) && typeof showToast === 'function') {
                        localStorage.setItem('btc_quest_hint_' + stepId, '1');
                        showToast(QUEST_STEPS[stepId].detail, 4000);
                    }
                } catch (e) {}
                return;
            }
            rememberPending(stepId);
        }).catch(function () {
            rememberPending(stepId);
            if (typeof showToast === 'function') showToast('Reward will be saved when you are back online.', 4000);
            advanceLocal();
        });
    };

    function signalSeen(signal) {
        if (signal === 'channel') {
            if (localStorage.getItem('btc_nacho_quest_channel') === '1') return true;
            try { return JSON.parse(localStorage.getItem('btc_visited_channels') || '[]').length > (window._nqBaseVisited || 0); }
            catch (e) { return false; }
        }
        if (signal === 'chat') {
            var msgs = parseInt(localStorage.getItem('btc_chat_msgs') || '0', 10) || 0;
            return msgs > (window._nqBaseChat || 0);
        }
        if (signal === 'spin') {
            var day = localStorage.getItem('btc_spin_last_day') || '';
            return !!(day && day !== (window._nqBaseSpin || ''));
        }
        if (signal === 'nacho') {
            var q = parseInt(localStorage.getItem('btc_nacho_questions') || '0', 10) || 0;
            return q > (window._nqBaseNacho || 0) || localStorage.getItem('btc_nacho_quest_nacho') === '1';
        }
        if (signal === 'quiz') {
            if (localStorage.getItem('btc_nacho_quest_quiz') === '1') return true;
            var c = parseInt(localStorage.getItem('btc_daily_challenges_total') || '0', 10) || 0;
            return c > (window._nqBaseQuiz || 0);
        }
        return false;
    }

    window.startNachoQuestDetection = function () {
        if (window._nachoQuestDetectionActive || window.isNachoQuestDone()) return;
        window._nachoQuestDetectionActive = true;
        try { window._nqBaseVisited = JSON.parse(localStorage.getItem('btc_visited_channels') || '[]').length; } catch (e) { window._nqBaseVisited = 0; }
        window._nqBaseChat = parseInt(localStorage.getItem('btc_chat_msgs') || '0', 10) || 0;
        window._nqBaseSpin = localStorage.getItem('btc_spin_last_day') || '';
        window._nqBaseNacho = parseInt(localStorage.getItem('btc_nacho_questions') || '0', 10) || 0;
        window._nqBaseQuiz = parseInt(localStorage.getItem('btc_daily_challenges_total') || '0', 10) || 0;
        window._nachoQuestPollInterval = setInterval(function () {
            if (!window.isNachoQuestActive() || window.isNachoQuestDone()) {
                clearInterval(window._nachoQuestPollInterval);
                window._nachoQuestDetectionActive = false;
                return;
            }
            var id = currentStepId();
            var step = QUEST_STEPS[id];
            if (!step) return;
            var wait = parseInt(localStorage.getItem('btc_quest_wait_' + id) || '0', 10) || 0;
            if (wait && Date.now() < wait) return;
            var flag = 'btc_quest_step_done_' + id;
            if (localStorage.getItem(flag) === '1') return;
            if (!signalSeen(step.signal)) return;
            try { localStorage.setItem(flag, '1'); } catch (e) {}
            window._completeNachoQuestStep(id);
        }, 700);
    };

    function questChromeOpen() {
        var modal = document.getElementById('usernameModal');
        if (modal && modal.classList.contains('open')) return true;
        if (document.getElementById('mfaSignInOverlay')) return true;
        if (document.getElementById('totpSignInOverlay')) return true;
        var tos = document.getElementById('tosModal');
        if (tos && tos.classList.contains('open')) return true;
        if (document.getElementById('btcIntroOverlay')) return true;
        var repick = document.getElementById('usernameRepick');
        if (repick && window.getComputedStyle(repick).display !== 'none') return true;
        return false;
    }

    function placeNachoQuestPill(btn) {
        if (!btn) return;
        if (questChromeOpen()) {
            btn.style.display = 'none';
            return;
        }
        // Phones: left side of the open band under the round logo and above
        // the title. The Invite pill uses the right side of the band above it.
        // Ticker shifts that band down 76px. Desktop: right edge under the bell,
        // above the minimized Invite pill, clear of Nacho and the FAB row.
        var phone = window.innerWidth <= 900;
        var ticker = document.body.classList.contains('ticker-visible');
        var base = 'z-index:2100001;background:var(--accent,#f97316);color:#fff;border:none;border-radius:24px;padding:10px 18px;font-size:16px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 4px 16px rgba(0,0,0,0.25);touch-action:manipulation;';
        if (phone) {
            var top = ticker ? 296 : 220;
            btn.style.cssText = 'position:fixed;display:block;top:calc(' + top + 'px + env(safe-area-inset-top, 0px));left:max(12px, env(safe-area-inset-left, 0px));right:auto;bottom:auto;transform:none;' + base + 'padding:6px 12px;font-size:13px;line-height:1.15;box-shadow:0 2px 8px rgba(0,0,0,0.25);';
        } else {
            btn.style.cssText = 'position:fixed;display:block;top:calc(100px + env(safe-area-inset-top, 0px));right:max(12px, env(safe-area-inset-right, 0px));left:auto;bottom:auto;transform:none;' + base;
        }
        var banner = document.querySelector('.favor-banner-progress');
        if (banner) {
            var box = btn.getBoundingClientRect();
            var labels = banner.querySelectorAll('span');
            for (var i = 0; i < labels.length; i++) {
                if ((labels[i].textContent || '').indexOf("Satoshi's Favor") === -1) continue;
                var title = labels[i].getBoundingClientRect();
                var hit = !(box.right < title.left || box.left > title.right || box.bottom < title.top || box.top > title.bottom);
                if (!hit) continue;
                btn.style.top = Math.round(title.bottom + 8) + 'px';
                btn.style.bottom = 'auto';
                if (phone) {
                    btn.style.left = 'max(12px, env(safe-area-inset-left, 0px))';
                    btn.style.right = 'auto';
                } else {
                    btn.style.right = 'max(12px, env(safe-area-inset-right, 0px))';
                    btn.style.left = 'auto';
                }
                btn.style.transform = 'none';
            }
        }
        var blockers = [];
        var guestPill = document.getElementById('inviteGuestPill');
        if (guestPill && !guestPill.hasAttribute('hidden')) blockers.push(guestPill);
        var card = document.getElementById('inviteCard');
        if (card && card.getAttribute('data-show') === '1') {
            var inviteState = card.getAttribute('data-state');
            if (inviteState === 'min') {
                var invite = document.getElementById('invitePill');
                if (invite) blockers.push(invite);
            } else if (inviteState === 'open') {
                blockers.push(card);
            }
        }
        var lowest = null;
        var b;
        for (b = 0; b < blockers.length; b++) {
            var ib = blockers[b].getBoundingClientRect();
            var qb = btn.getBoundingClientRect();
            if (ib.width < 1 || ib.height < 1) continue;
            var stacked = !(qb.right < ib.left - 8 || qb.left > ib.right + 8 || qb.bottom < ib.top - 8 || qb.top > ib.bottom + 8);
            if (!stacked) continue;
            if (lowest === null || ib.bottom > lowest) lowest = ib.bottom;
        }
        if (lowest !== null) {
            btn.style.top = Math.round(lowest + 12) + 'px';
            btn.style.bottom = 'auto';
        }
        var avoidIds = ['homeHero', 'homeWalletStrip', 'homeGuestActions', 'curatedStartSection', 'todayFavorStrip', 'todayCardTitle', 'homeLearnTitle', 'homeLearnKicker', 'guestPointsBanner'];
        for (var a = 0; a < avoidIds.length; a++) {
            var block = document.getElementById(avoidIds[a]);
            if (!block) continue;
            var bcs = window.getComputedStyle(block);
            if (bcs.display === 'none' || bcs.visibility === 'hidden') continue;
            var br = block.getBoundingClientRect();
            if (br.width < 1 || br.height < 1) continue;
            var qb2 = btn.getBoundingClientRect();
            var overlap = !(qb2.right < br.left || qb2.left > br.right || qb2.bottom < br.top || qb2.top > br.bottom);
            if (!overlap) continue;
            btn.style.top = Math.round(br.bottom + 8) + 'px';
            btn.style.bottom = 'auto';
        }
        var heads = document.querySelectorAll('#home h1, #home h2, #home h3, #curatedStartSection, #todayFavorStrip, #homeLearnKicker, #homeLearnTitle');
        for (var h = 0; h < heads.length; h++) {
            var head = heads[h];
            var hcs = window.getComputedStyle(head);
            if (hcs.display === 'none' || hcs.visibility === 'hidden') continue;
            var hr = head.getBoundingClientRect();
            if (hr.width < 1 || hr.height < 1) continue;
            var qb3 = btn.getBoundingClientRect();
            var hover = !(qb3.right < hr.left || qb3.left > hr.right || qb3.bottom < hr.top || qb3.top > hr.bottom);
            if (!hover) continue;
            btn.style.top = Math.round(hr.bottom + 8) + 'px';
            btn.style.bottom = 'auto';
        }
        function clearOfTodayCard() {
            var ids = ['todayCard', 'dailyXpMeter', 'dailyXpMeterText', 'dailyXpMeterFill'];
            var limitIds = ['bottomNav', 'chatOverlayBtn', 'nacho-toggle', 'fabExpandBtn'];
            var i, el, br, qb, above, below, limit, j, ob, or;
            for (i = 0; i < ids.length; i++) {
                el = document.getElementById(ids[i]);
                if (!el) continue;
                var cs = window.getComputedStyle(el);
                if (cs.display === 'none' || cs.visibility === 'hidden') continue;
                br = el.getBoundingClientRect();
                qb = btn.getBoundingClientRect();
                if (br.width < 1 || br.height < 1) continue;
                if (qb.right < br.left || qb.left > br.right || qb.bottom < br.top || qb.top > br.bottom) continue;
                above = Math.round(br.top - 8 - qb.height);
                below = Math.round(br.bottom + 8);
                limit = window.innerHeight - 8;
                for (j = 0; j < limitIds.length; j++) {
                    ob = document.getElementById(limitIds[j]);
                    if (!ob) continue;
                    var ocs = window.getComputedStyle(ob);
                    if (ocs.display === 'none' || ocs.visibility === 'hidden') continue;
                    or = ob.getBoundingClientRect();
                    if (or.height < 8 || or.top < window.innerHeight * 0.45) continue;
                    if (or.top - 8 < limit) limit = or.top - 8;
                }
                if (below + qb.height <= limit) btn.style.top = below + 'px';
                else btn.style.top = Math.max(8, above) + 'px';
                btn.style.bottom = 'auto';
            }
        }
        clearOfTodayCard();
        var nav = document.getElementById('bottomNav');
        var maxBottom = window.innerHeight - 8;
        if (nav) {
            var nr = nav.getBoundingClientRect();
            if (nr.height > 8 && nr.top > 80) maxBottom = nr.top - 8;
        }
        var pb = btn.getBoundingClientRect();
        if (pb.bottom > maxBottom) {
            btn.style.top = Math.max(8, Math.round(maxBottom - pb.height)) + 'px';
            btn.style.bottom = 'auto';
        }
        clearOfTodayCard();
    }
    window._placeNachoQuestPill = placeNachoQuestPill;

    window._showNachoQuestPill = function () {
        if (window.isNachoQuestDone() || !window.isNachoQuestActive()) return;
        var existing = document.getElementById('nachoQuestPill');
        if (existing) existing.remove();
        var list = questList();
        var btn = document.createElement('button');
        btn.id = 'nachoQuestPill';
        btn.type = 'button';
        placeNachoQuestPill(btn);
        btn.textContent = 'Quest · ' + (window.getNachoQuestStep() + 1) + '/' + list.length;
        btn.addEventListener('click', function () { window._showNachoQuestOverlay(); });
        document.body.appendChild(btn);
        if (window._questPillWatch) return;
        window._questPillWatch = true;
        window.addEventListener('resize', function () {
            var pill = document.getElementById('nachoQuestPill');
            if (pill) placeNachoQuestPill(pill);
        });
        if (window.MutationObserver) {
            new MutationObserver(function () {
                var pill = document.getElementById('nachoQuestPill');
                if (pill) placeNachoQuestPill(pill);
            }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
        }
        var modal = document.getElementById('usernameModal');
        if (modal && window.MutationObserver) {
            new MutationObserver(function () {
                var pill = document.getElementById('nachoQuestPill');
                if (pill) placeNachoQuestPill(pill);
            }).observe(modal, { attributes: true, attributeFilter: ['class'] });
        }
        function watchInvite(el, filter) {
            if (!el || !window.MutationObserver) return;
            new MutationObserver(function () {
                var pill = document.getElementById('nachoQuestPill');
                if (pill) placeNachoQuestPill(pill);
            }).observe(el, { attributes: true, attributeFilter: filter });
        }
        watchInvite(document.getElementById('inviteCard'), ['data-state', 'data-show', 'style']);
        watchInvite(document.getElementById('inviteGuestPill'), ['hidden', 'style']);
    };

    window._showNachoQuestOverlay = function () {
        if (window.isNachoQuestDone()) return;
        var old = document.getElementById('nachoQuestOverlay');
        if (old) old.remove();
        var id = currentStepId();
        var step = QUEST_STEPS[id];
        if (!step) return;
        var list = questList();
        var overlay = document.createElement('div');
        overlay.id = 'nachoQuestOverlay';
        overlay.style.cssText = 'position:fixed;inset:0;z-index:2100002;background:var(--bg,#020617);display:flex;align-items:flex-end;justify-content:center;padding:16px;';
        var card = document.createElement('div');
        card.style.cssText = 'background:var(--bg-side,#0f172a);color:var(--text,#e2e8f0);border:1px solid var(--border,#1e293b);border-radius:20px;padding:22px 18px;max-width:420px;width:100%;';
        var kicker = document.createElement('div');
        kicker.style.cssText = 'font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:var(--accent,#f97316);font-weight:800;';
        kicker.textContent = 'Step ' + (window.getNachoQuestStep() + 1) + ' of ' + list.length;
        var title = document.createElement('h2');
        title.style.cssText = 'color:var(--heading,#fff);font-size:1.25rem;margin:8px 0;';
        title.textContent = step.title;
        var detail = document.createElement('p');
        detail.style.cssText = 'color:var(--text-muted,#94a3b8);font-size:0.95rem;line-height:1.45;margin:0 0 16px;';
        detail.textContent = step.detail;
        var row = document.createElement('div');
        row.style.cssText = 'display:flex;gap:8px;';
        var close = document.createElement('button');
        close.type = 'button';
        close.textContent = 'Close';
        close.style.cssText = 'flex:1;padding:12px;border-radius:12px;border:1px solid var(--border);background:transparent;color:var(--text);font-size:16px;font-family:inherit;cursor:pointer;';
        close.addEventListener('click', function () { overlay.remove(); });
        var skip = document.createElement('button');
        skip.type = 'button';
        skip.textContent = 'Skip quest';
        skip.style.cssText = 'flex:1;padding:12px;border-radius:12px;border:none;background:var(--accent,#f97316);color:#fff;font-size:16px;font-weight:700;font-family:inherit;cursor:pointer;';
        skip.addEventListener('click', function () { window._skipNachoQuest(); overlay.remove(); });
        row.appendChild(close);
        row.appendChild(skip);
        card.appendChild(kicker);
        card.appendChild(title);
        card.appendChild(detail);
        card.appendChild(row);
        overlay.appendChild(card);
        overlay.addEventListener('click', function (e) { if (e.target === overlay) overlay.remove(); });
        document.body.appendChild(overlay);
        window._nachoQuestBeaconForStep(window.getNachoQuestStep());
    };

    window._skipNachoQuest = function () {
        try {
            localStorage.setItem(QUEST_DONE, '1');
            localStorage.removeItem(QUEST_ACTIVE);
        } catch (e) {}
        window._clearNachoQuestBeacon && window._clearNachoQuestBeacon();
        var pill = document.getElementById('nachoQuestPill');
        if (pill) pill.remove();
        if (window._nachoQuestPollInterval) clearInterval(window._nachoQuestPollInterval);
    };

    window._clearNachoQuestBeacon = function () {
        var b = document.getElementById('nachoQuestBeacon');
        if (b) b.remove();
    };
    window._showNachoQuestBeacon = function (selector) {
        window._clearNachoQuestBeacon();
        if (!selector) return;
        var el = document.querySelector(selector);
        if (!el) return;
        var b = document.createElement('div');
        b.id = 'nachoQuestBeacon';
        b.style.cssText = 'position:fixed;width:18px;height:18px;border-radius:50%;border:3px solid var(--accent,#f97316);pointer-events:none;z-index:8998;box-shadow:0 0 0 6px rgba(249,115,22,0.25);';
        document.body.appendChild(b);
        function place() {
            if (!document.body.contains(el) || !document.body.contains(b)) return;
            var r = el.getBoundingClientRect();
            b.style.top = Math.max(8, r.top + 8) + 'px';
            b.style.left = Math.max(8, r.left + r.width - 18) + 'px';
        }
        place();
        window.addEventListener('scroll', place, true);
        window.addEventListener('resize', place);
    };
    window._nachoQuestBeaconForStep = function (idx) {
        var list = questList();
        var step = QUEST_STEPS[list[idx]];
        if (step && step.beacon) window._showNachoQuestBeacon(step.beacon);
        else window._clearNachoQuestBeacon();
    };

    window.startNachoQuest = function (opts) {
        if (window.isNachoQuestDone()) return;
        try {
            localStorage.setItem(QUEST_ACTIVE, '1');
            if (!localStorage.getItem(QUEST_STEP)) localStorage.setItem(QUEST_STEP, '0');
        } catch (e) {}
        window._showNachoQuestPill();
        window.startNachoQuestDetection();
        var pillOnly = opts && opts.pillOnly;
        var slotTaken = false;
        try { slotTaken = sessionStorage.getItem('btc_session_popup') === 'onboarding'; } catch (e) {}
        if (!pillOnly && !slotTaken) window._showNachoQuestOverlay();
    };

    function markIntroSeen() {
        try { localStorage.setItem(INTRO_KEY, '1'); localStorage.setItem('btc_onboarding_done', 'true'); } catch (e) {}
        if (signedInReal()) callFn('markIntroSeen', {}).catch(function () {});
    }

    function alreadyOnboarded() {
        try {
            if (localStorage.getItem(INTRO_KEY) === '1' || localStorage.getItem('btc_onboarding_done') === 'true') return true;
            if (localStorage.getItem('btc_username')) { localStorage.setItem(INTRO_KEY, '1'); return true; }
            var cache = JSON.parse(localStorage.getItem('btc_profile_cache') || 'null');
            if (cache && cache.data && cache.data.username) { localStorage.setItem(INTRO_KEY, '1'); return true; }
        } catch (e) {}
        return false;
    }

    var SLIDES = [
        {
            kicker: 'Learn',
            title: 'Channels, quests, and Nacho',
            body: 'Read Bitcoin topics, follow a quest, and ask Nacho — the AI deer — when you want it in plain language.',
            items: [
                { label: 'Learn channels', tryId: 'channels' },
                { label: 'Quests', tryId: 'quests' },
                { label: 'Nacho', tryId: 'nacho' }
            ]
        },
        {
            kicker: 'Daily',
            title: 'A reason to come back',
            body: 'Spin the wheel, finish the daily challenge, and answer trivia or a poll. Each one pays XP.',
            items: [
                { label: 'Daily spin', tryId: 'spin' },
                { label: 'Trivia and polls', tryId: 'trivia' }
            ]
        },
        {
            kicker: 'People',
            title: 'Talk, post, trade',
            body: 'Global Chat is live. PlebTalk is the forum. LightningMart is the marketplace. A buddy is optional.',
            items: [
                { label: 'Global Chat', tryId: 'chat' },
                { label: 'PlebTalk', tryId: 'forum' },
                { label: 'Marketplace', tryId: 'market' },
                { label: 'Find a buddy', tryId: 'buddy' }
            ]
        },
        {
            kicker: 'Play and earn',
            title: 'Tickets, XP, and games',
            body: 'Watch Timechain TV, play Bitcoin Beats, duel in PvP, hash for Satoshi\'s Favor, open ciphers, join a raid, or share a referral. Orange tickets and XP add up. If an accepted peer opens a matching cipher with a key you sent, you both get the same prize and you see a reveal of what you won. That counts as one of your 21 cipher opens that day, pays once per cipher, and includes sats only when both accounts are eligible.',
            items: [
                { label: 'Timechain TV', tryId: 'tv' },
                { label: 'Bitcoin Beats', tryId: 'beats' },
                { label: 'PvP', tryId: 'pvp' },
                { label: 'Satoshi\'s Favor', tryId: 'favor' },
                { label: 'Ciphers and raids', tryId: 'ciphers' },
                { label: 'Referrals', tryId: 'referral' }
            ]
        },
        {
            kicker: 'Your pace',
            title: 'How much do you want to see?',
            body: 'You can change this anytime in Settings. Your XP stays either way.',
            mode: true
        }
    ];

    function tryFeature(id) {
        markIntroSeen();
        var overlay = document.getElementById('btcIntroOverlay');
        if (overlay) overlay.remove();
        var fns = {
            channels: function () { if (typeof go === 'function') go('one-stop-shop'); },
            quests: function () { if (typeof showQuestHub === 'function') showQuestHub(); },
            nacho: function () { if (typeof enterNachoMode === 'function') enterNachoMode(); },
            spin: function () { if (typeof showSpinWheel === 'function') showSpinWheel(); },
            trivia: function () { if (typeof showQuestHub === 'function') showQuestHub(); },
            chat: function () {
                if (typeof renderChatHub === 'function') renderChatHub('global');
                else if (typeof toggleChatOverlay === 'function') toggleChatOverlay();
            },
            forum: function () { if (typeof go === 'function') go('forum'); },
            market: function () { if (typeof go === 'function') go('marketplace'); },
            tv: function () { if (typeof go === 'function') go('timechain-tv'); },
            beats: function () { if (typeof go === 'function') go('bitcoin-beats'); },
            pvp: function () { if (typeof enterPVPMode === 'function') enterPVPMode(); },
            favor: function () { if (typeof openSatoshiFavorMiner === 'function') openSatoshiFavorMiner(); },
            buddy: function () { if (typeof showBuddyFinder === 'function') showBuddyFinder(); },
            ciphers: function () { if (typeof showQuestHub === 'function') showQuestHub(); },
            referral: function () {
                if (typeof showSettings === 'function') showSettings();
                setTimeout(function () { if (typeof showSettingsPage === 'function') showSettingsPage('account'); }, 120);
            }
        };
        var fn = fns[id];
        if (fn) fn();
        window.startNachoQuest({ pillOnly: true });
    }

    function renderIntro(slide) {
        var overlay = document.getElementById('btcIntroOverlay');
        if (!overlay) return;
        var data = SLIDES[slide] || SLIDES[0];
        var card = overlay.querySelector('[data-intro-card]');
        card.textContent = '';
        var top = document.createElement('div');
        top.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px;';
        var dots = document.createElement('div');
        dots.style.cssText = 'display:flex;gap:6px;';
        SLIDES.forEach(function (_, i) {
            var dot = document.createElement('span');
            dot.style.cssText = 'width:8px;height:8px;border-radius:50%;background:' + (i === slide ? 'var(--accent,#f97316)' : 'var(--border,#334155)') + ';';
            dots.appendChild(dot);
        });
        var skip = document.createElement('button');
        skip.type = 'button';
        skip.textContent = 'Skip';
        skip.style.cssText = 'background:transparent;border:none;color:var(--text-muted);font-size:16px;font-family:inherit;cursor:pointer;padding:8px;';
        skip.addEventListener('click', finishIntro);
        top.appendChild(dots);
        top.appendChild(skip);
        var kicker = document.createElement('div');
        kicker.textContent = data.kicker;
        kicker.style.cssText = 'color:var(--accent,#f97316);font-size:12px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;';
        var title = document.createElement('h2');
        title.textContent = data.title;
        title.style.cssText = 'color:var(--heading);font-size:1.45rem;line-height:1.2;margin:8px 0;';
        var body = document.createElement('p');
        body.textContent = data.body;
        body.style.cssText = 'color:var(--text);font-size:1rem;line-height:1.45;margin:0 0 14px;';
        card.appendChild(top);
        card.appendChild(kicker);
        card.appendChild(title);
        if (slide === 0) {
            var deer = document.createElement('img');
            deer.src = 'nacho-deer.svg';
            deer.alt = 'Nacho';
            deer.width = 96;
            deer.height = 96;
            deer.style.cssText = 'display:block;width:96px;height:96px;margin:4px 0 10px;';
            card.appendChild(deer);
        }
        card.appendChild(body);
        if (data.items) {
            data.items.forEach(function (item) {
                var row = document.createElement('div');
                row.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 0;border-top:1px solid var(--border);';
                var label = document.createElement('span');
                label.textContent = item.label;
                label.style.cssText = 'color:var(--heading);font-weight:700;font-size:0.95rem;';
                var tryBtn = document.createElement('button');
                tryBtn.type = 'button';
                tryBtn.textContent = 'Try it';
                tryBtn.style.cssText = 'background:transparent;border:1px solid var(--border);color:var(--accent,#f97316);border-radius:999px;padding:6px 12px;font-size:16px;font-family:inherit;cursor:pointer;';
                tryBtn.addEventListener('click', function () { tryFeature(item.tryId); });
                row.appendChild(label);
                row.appendChild(tryBtn);
                card.appendChild(row);
            });
        }
        if (data.mode) {
            [['beginner', 'Guided', 'A quieter home'], ['intermediate', 'Balanced', 'Apps, less noise'], ['advanced', 'Everything', 'All tools visible']].forEach(function (m) {
                var b = document.createElement('button');
                b.type = 'button';
                b.style.cssText = 'display:block;width:100%;text-align:left;margin-bottom:8px;padding:12px;border-radius:12px;border:1px solid var(--border);background:var(--bg);color:var(--heading);font-family:inherit;font-size:16px;cursor:pointer;';
                var strong = document.createElement('strong');
                strong.textContent = m[1];
                var small = document.createElement('div');
                small.textContent = m[2];
                small.style.cssText = 'color:var(--text-muted);font-size:0.85rem;font-weight:500;margin-top:2px;';
                b.appendChild(strong);
                b.appendChild(small);
                b.addEventListener('click', function () {
                    window.setExperienceMode(m[0]);
                    card.querySelectorAll('button').forEach(function (el) { el.style.borderColor = 'var(--border)'; });
                    b.style.borderColor = 'var(--accent,#f97316)';
                });
                card.appendChild(b);
            });
        }
        var next = document.createElement('button');
        next.type = 'button';
        next.textContent = slide >= SLIDES.length - 1 ? 'Start exploring' : 'Next';
        next.style.cssText = 'width:100%;margin-top:14px;padding:14px;border:none;border-radius:12px;background:var(--accent,#f97316);color:#fff;font-size:16px;font-weight:800;font-family:inherit;cursor:pointer;';
        next.addEventListener('click', function () {
            if (slide >= SLIDES.length - 1) finishIntro();
            else renderIntro(slide + 1);
        });
        card.appendChild(next);
        var start = document.createElement('button');
        start.type = 'button';
        start.textContent = 'Start exploring';
        start.style.cssText = 'width:100%;margin-top:8px;padding:10px;border:none;background:transparent;color:var(--text-muted);font-size:16px;font-family:inherit;cursor:pointer;';
        start.addEventListener('click', finishIntro);
        if (slide < SLIDES.length - 1) card.appendChild(start);
    }

    function finishIntro() {
        if (!localStorage.getItem('btc_experience_mode')) window.setExperienceMode('advanced');
        markIntroSeen();
        var overlay = document.getElementById('btcIntroOverlay');
        if (overlay) overlay.remove();
        window.applySimplifiedHome();
        window.startNachoQuest({ pillOnly: true });
    }

    window.showOnboardingIntro = function (opts) {
        var force = opts && opts.force;
        if (!force && alreadyOnboarded()) return false;
        window.btcClaimSessionPopup('onboarding');
        var old = document.getElementById('btcIntroOverlay');
        if (old) old.remove();
        var overlay = document.createElement('div');
        overlay.id = 'btcIntroOverlay';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-label', 'Welcome tour');
        var wide = window.innerWidth > 800;
        overlay.style.cssText = 'position:fixed;inset:0;z-index:2100003;background:var(--bg,#020617);display:flex;align-items:' + (wide ? 'center' : 'flex-end') + ';justify-content:center;padding:' + (wide ? '24px' : '0') + ';';
        var card = document.createElement('div');
        card.setAttribute('data-intro-card', '1');
        card.style.cssText = 'background:var(--bg-side,#0f172a);color:var(--text,#e2e8f0);width:100%;max-width:520px;max-height:100%;overflow:auto;border-radius:' + (wide ? '20px' : '20px 20px 0 0') + ';padding:18px 18px 28px;border:1px solid var(--border);';
        overlay.appendChild(card);
        document.body.appendChild(overlay);
        renderIntro((opts && typeof opts.slide === 'number') ? opts.slide : 0);
        return true;
    };
    window.showOnboardingWizard = function () { return window.showOnboardingIntro(); };

    var CURATED = {
        beginner: ['one-stop-shop', 'whitepaper', 'problems-of-money', 'self-custody'],
        intermediate: ['mining', 'layer-2-lightning', 'self-custody', 'nodes']
    };
    window.applySimplifiedHome = function () {
        var level = window.getUserSimplificationLevel();
        var hide = {
            beginner: ['#dailySpinBanner', '#progressRings', '#dailyChallengeCard', '#quoteOfDay', '#explorationMap', '#donateSection', '#homeAppsBtn', '#homeAppsMenu', '#desktopDMBtn', '#rankBar', '#activity-ticker', '#continueReading'],
            intermediate: ['#dailySpinBanner', '#progressRings', '#explorationMap', '#activity-ticker', '#featuredOnSection', '#introVideoSection', '#countryUsersSection', '#quoteOfDay']
        };
        document.querySelectorAll('[data-simplified-hidden]').forEach(function (el) {
            el.style.display = '';
            el.removeAttribute('data-simplified-hidden');
        });
        var old = document.getElementById('curatedStartSection');
        if (old) old.remove();
        if (level === 'full') return;
        (hide[level] || []).forEach(function (sel) {
            if (sel === '#introVideoSection' && window._forceIntroVideo) return;
            document.querySelectorAll(sel).forEach(function (el) {
                el.setAttribute('data-simplified-hidden', '1');
                el.style.display = 'none';
            });
        });
        // The home page already has one Learn card. Do not add a chip list above it.
        if (document.getElementById('homeLearnCard')) return;
        var home = document.getElementById('home');
        var ids = CURATED[level] || [];
        if (!home || !ids.length || typeof CHANNELS === 'undefined') return;
        var box = document.createElement('div');
        box.id = 'curatedStartSection';
        box.style.cssText = 'max-width:480px;margin:0 auto 20px;text-align:left;';
        var heading = document.createElement('div');
        heading.textContent = level === 'beginner' ? 'Start here' : 'Picked for you';
        heading.style.cssText = 'font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);font-weight:800;margin-bottom:8px;';
        box.appendChild(heading);
        if (level === 'beginner') {
            var quizBtn = document.createElement('button');
            quizBtn.id = 'onboardingQuizEntry';
            quizBtn.type = 'button';
            quizBtn.textContent = 'Try a quiz';
            quizBtn.style.cssText = 'display:block;width:100%;text-align:left;padding:14px;margin-bottom:8px;border-radius:12px;border:1px solid var(--accent,#f97316);background:var(--bg-side);color:var(--heading);font-family:inherit;font-size:16px;font-weight:700;cursor:pointer;';
            quizBtn.addEventListener('click', function () {
                if (typeof window.showQuestHub === 'function') window.showQuestHub();
            });
            box.appendChild(quizBtn);
        }
        ids.forEach(function (id) {
            if (!CHANNELS[id]) return;
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.style.cssText = 'display:block;width:100%;text-align:left;padding:14px;margin-bottom:8px;border-radius:12px;border:1px solid var(--border);background:var(--bg-side);color:var(--heading);font-family:inherit;font-size:16px;cursor:pointer;';
            btn.textContent = String(CHANNELS[id].title || id).replace(/^[^\w]+/, '');
            btn.addEventListener('click', function () { if (typeof go === 'function') go(id); });
            box.appendChild(btn);
        });
        var learn = document.getElementById('homeLearnCard');
        if (learn && learn.parentNode) learn.parentNode.insertBefore(box, learn);
        else {
            var sub = home.querySelector('.home-subtitle');
            if (sub && sub.parentNode) sub.parentNode.insertBefore(box, sub.nextSibling);
            else home.insertBefore(box, home.firstChild);
        }
    };
    window.checkProgressiveReveal = function () {};

    function hookNav() {
        if (typeof window.go === 'function' && !window._nqGoHooked) {
            window._nqGoHooked = true;
            var origGo = window.go;
            window.go = function () {
                var out = origGo.apply(this, arguments);
                try {
                    if (window.isNachoQuestActive() && currentStepId() === 'pick_topic') {
                        localStorage.setItem('btc_nacho_quest_channel', '1');
                    }
                } catch (e) {}
                return out;
            };
        }
        if (typeof window.toggleChatOverlay === 'function' && !window._nqChatHooked) {
            window._nqChatHooked = true;
            var origChat = window.toggleChatOverlay;
            window.toggleChatOverlay = function () {
                var out = origChat.apply(this, arguments);
                return out;
            };
        }
        if (typeof window.nachoModeSend === 'function' && !window._nqNachoHooked) {
            window._nqNachoHooked = true;
            var origSend = window.nachoModeSend;
            window.nachoModeSend = function () {
                var out = origSend.apply(this, arguments);
                try {
                    if (window.isNachoQuestActive()) localStorage.setItem('btc_nacho_quest_nacho', '1');
                    if (typeof auth !== 'undefined' && auth && auth.currentUser) {
                        callFn('noteNachoQuestion', { text: 'question' }).catch(function () {});
                    }
                } catch (e) {}
                return out;
            };
        }
    }

    window.addEventListener('onboarding_quiz_done', function () {
        try { localStorage.setItem('btc_nacho_quest_quiz', '1'); } catch (e) {}
    });

    function boot() {
        hookNav();
        setTimeout(hookNav, 1500);
        if (!alreadyOnboarded()) window.btcClaimSessionPopup('onboarding');
        var hashed = false;
        try { hashed = !!(location.hash && location.hash.length > 1); } catch (e) {}
        if (!alreadyOnboarded() && !hashed) window.showOnboardingIntro();
        else {
            window.applySimplifiedHome();
            if (window.isNachoQuestActive() && !window.isNachoQuestDone()) {
                window._showNachoQuestPill();
                window.startNachoQuestDetection();
            }
        }
        window.addEventListener('hashchange', function () {
            var still = false;
            try { still = !!(location.hash && location.hash.length > 1); } catch (e) {}
            if (!still && !alreadyOnboarded() && !document.getElementById('btcIntroOverlay')) window.showOnboardingIntro();
        });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
})();
